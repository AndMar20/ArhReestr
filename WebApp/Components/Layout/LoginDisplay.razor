@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@using System.Security.Claims

<div class="authorize-block">
    <AuthorizeView>
        <Authorized>
            <span class="user-name">@DisplayName</span>
            <form method="post" action="/logout" class="logout-form">
                <AntiforgeryToken />
                <button type="submit" class="link-button">Выйти</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink href="/login">Войти</NavLink>
            <NavLink href="/register">Регистрация</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string DisplayName { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userIdRaw = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!int.TryParse(userIdRaw, out var userId))
        {
            DisplayName = state.User.Identity?.Name ?? string.Empty;
            return;
        }

        var user = await UserManager.FindByIdAsync(userId.ToString());
        DisplayName = user?.FullName ?? state.User.Identity?.Name ?? string.Empty;
    }
}

@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using global::System.Security.Claims
@using WebApp.Infrastructure
@inject DatabaseHealthState DatabaseHealthState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject ChatService ChatService

<PageTitle>АрхРеестр</PageTitle>

<div class="page">
    <header class="top-bar">
        <div class="container nav-inner">
            <div class="nav-header">
                <NavLink class="brand" href="/search" Match="NavLinkMatch.All" @onclick="CloseMenu">
                    <img class="brand-logo" height="50" width="100" src="Images/Logo/app-logo.png" alt="Логотип АрхРеестр" />
                </NavLink>
                <button
                    type="button"
                    class="nav-toggle"
                    aria-label="Открыть меню"
                    aria-controls="main-nav"
                    aria-expanded="@isMenuOpen"
                    @onclick="ToggleMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
            <div id="main-nav" class="@NavMenuClass">
                <nav>
                    <NavLink href="/" class="@CatalogLinkClass" Match="NavLinkMatch.All" @onclick="CloseMenu">Каталог объектов</NavLink>
                    <NavLink href="/favorites" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Избранное</NavLink>
                    <AuthorizeView Roles="admin">
                        <Authorized>
                            <NavLink href="/admin" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Кабинет администратора</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="agent">
                        <Authorized>
                            <NavLink href="/realtor" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Кабинет риелтора</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="client">
                        <Authorized>
                            <NavLink href="/client" class="nav-link" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">Кабинет клиента</NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="agent,client">
                        <Authorized>
                            <NavLink href="/chat" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                                Чат
                                @if (UnreadChatCount > 0)
                                {
                                    <span class="nav-counter">@UnreadChatCount</span>
                                }
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView>
                        <Authorized>
                            <NavLink href="/notifications" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
                                Уведомления
                                @if (UnreadNotificationCount > 0)
                                {
                                    <span class="nav-counter">@UnreadNotificationCount</span>
                                }
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                </nav>
                <LoginDisplay />
            </div>
        </div>
    </header>
    <main>
        <div class="container">
            @if (!DatabaseHealthState.IsAvailable && !string.IsNullOrWhiteSpace(DatabaseHealthState.Message))
            {
                <div class="alert error" style="margin-top:1rem;">
                    База данных временно недоступна: @DatabaseHealthState.Message
                </div>
            }
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    Возникла непредвиденная ошибка. <a href="" class="reload">Обновить страницу</a>
    <button type="button" class="dismiss" aria-label="Закрыть">×</button>
</div>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private bool isMenuOpen;
    private int UnreadChatCount { get; set; }
    private int UnreadNotificationCount { get; set; }

    private string NavMenuClass => isMenuOpen ? "nav-menu open" : "nav-menu";

    private string CatalogLinkClass
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].TrimEnd('/');
            return string.IsNullOrEmpty(path) || string.Equals(path, "search", StringComparison.OrdinalIgnoreCase)
                ? "active"
                : string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await RefreshCountersAsync();
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMenuOpen = false;
        _ = InvokeAsync(async () =>
        {
            await RefreshCountersAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshCountersAsync()
    {
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated != true ||
                !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
            {
                UnreadChatCount = 0;
                UnreadNotificationCount = 0;
                return;
            }

            UnreadNotificationCount = await NotificationService.GetUnreadCountAsync(currentUserId);
            UnreadChatCount = user.IsInRole("agent") || user.IsInRole("client")
                ? await ChatService.GetUnreadCountAsync(currentUserId)
                : 0;
        }
        catch
        {
            UnreadChatCount = 0;
            UnreadNotificationCount = 0;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

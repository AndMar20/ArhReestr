@page "/chat"
@attribute [Authorize(Roles = "agent,client")]
@using global::System.Security.Claims
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatService ChatService
@inject InteractionService InteractionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Чаты</PageTitle>

<section class="hero-card">
    <div class="section-header">
        <h1 class="section-title">Чаты по объектам</h1>
    </div>
</section>

<div class="chat-layout @(selectedRealEstateId > 0 ? "chat-open" : string.Empty)">
    <article class="panel chat-dialogs-panel">
        <h2>Диалоги</h2>
        <label class="chat-search">Поиск
            <input @bind="DialogSearch" @bind:event="oninput" placeholder="Клиент, объект, адрес" />
        </label>
        @if (dialogs.Count == 0)
        {
            <p class="small-text">Диалогов пока нет.</p>
        }
        else if (!FilteredDialogs.Any())
        {
            <p class="small-text">По этому запросу диалоги не найдены.</p>
        }
        else
        {
            @if (isAgent)
            {
                <div class="chat-client-groups">
                    @foreach (var group in FilteredDialogGroups)
                    {
                        <section class="chat-client-group">
                            <div class="chat-client-heading">
                                <strong>@group.ClientName</strong>
                                <span class="small-text">@group.Dialogs.Count диал.</span>
                            </div>
                            <ul class="list-clean">
                                @foreach (var d in group.Dialogs)
                                {
                                    <li @key="GetDialogKey(d)">
                                        <button class="ghost dialog-list-button @(IsSelectedDialog(d) ? "active" : string.Empty)" @onclick="() => OpenDialogAsync(d.RealEstateId, d.PeerId)">
                                            <span class="dialog-object-address">@d.RealEstateAddress</span>
                                            @if (d.HasUnread) { <span class="badge accent">new</span> }
                                        </button>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
            else
            {
                <ul class="list-clean">
                    @foreach (var d in FilteredDialogs)
                    {
                        <li @key="GetDialogKey(d)">
                                        <button class="ghost dialog-list-button @(IsSelectedDialog(d) ? "active" : string.Empty)" @onclick="() => OpenDialogAsync(d.RealEstateId, d.PeerId)">
                                <strong class="dialog-peer-name">@d.PeerName</strong><br />
                                <span class="small-text">@d.RealEstateAddress</span><br />
                                @if (d.HasUnread) { <span class="badge accent">new</span> }
                            </button>
                        </li>
                    }
                </ul>
            }
        }
    </article>

    <article class="panel chat-messages-panel">
        @if (!string.IsNullOrWhiteSpace(chatNotice))
        {
            <div class="alert info">@chatNotice</div>
        }

        @if (selectedRealEstateId == 0)
        {
            <p class="small-text">Выберите диалог.</p>
        }
        else
        {
            <div class="section-header chat-header">
                <button type="button" class="ghost chat-back-button" @onclick="BackToDialogs">Назад</button>
                <div class="chat-title-block">
                    <h2>Сообщения</h2>
                    @if (!string.IsNullOrWhiteSpace(selectedRealEstateAddress))
                    {
                        <span class="small-text">@selectedRealEstateAddress</span>
                    }
                </div>
                <div class="chat-menu-wrap">
                    <button type="button" class="icon-button chat-menu-button" @onclick="ToggleDialogMenu" aria-label="Действия диалога">⋯</button>
                    @if (isDialogMenuOpen)
                    {
                        <div class="chat-menu">
                            <NavLink class="ghost" href="@SelectedObjectUrl">К объекту</NavLink>
                            <button type="button" class="danger ghost" @onclick="DeleteSelectedDialogAsync" disabled="@isDeletingDialog">
                                @(isDeletingDialog ? "Удаляем..." : "Удалить диалог")
                            </button>
                        </div>
                    }
                </div>
            </div>
            @if (selectedInteraction is not null && !isClient)
            {
                <div class="chat-status-panel">
                    <div>
                        <span class="small-text">Статус взаимодействия</span>
                        <strong>@selectedInteraction.Status</strong>
                    </div>
                    @if (CanEditSelectedInteraction)
                    {
                        <InputSelect @bind-Value="selectedStatusId">
                            @foreach (var status in statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                        <button type="button" class="ghost" @onclick="UpdateInteractionStatusAsync" disabled="@isStatusSaving">
                            @(isStatusSaving ? "Сохранение..." : "Изменить статус")
                        </button>
                    }
                </div>
            }
            <div class="chat-messages" @ref="messagesContainer">
                @if (messages.Count == 0)
                {
                    <p class="small-text chat-empty-state">Сообщений пока нет.</p>
                }
                @foreach (var m in messages)
                {
                    var isMine = m.SenderId == userId;
                    <div class="chat-row @(isMine ? "mine" : "theirs")">
                        <div class="chat-bubble @(isMine ? "mine" : "theirs")">
                            @if (!isMine)
                            {
                                <div class="chat-author">@m.SenderName</div>
                            }
                            <div>@m.Message</div>
                            <div class="chat-meta">@DateTimeDisplay.Format(m.SentAt) · @(m.ReadAt.HasValue ? "прочитано" : "доставлено")</div>
                        </div>
                    </div>
                }
            </div>

            <div class="form-stack chat-send-form">
                <textarea class="input-textarea" @ref="messageInput" @oninput="OnMessageInput" @onkeydown="HandleMessageKeyDown" rows="@messageRows" style="resize:none;overflow:hidden;"></textarea>
                <button type="button" class="primary" disabled="@string.IsNullOrWhiteSpace(draft)" @onclick="SendAsync">Отправить</button>
            </div>
        }
    </article>
</div>

@code {
    private readonly List<ChatDialogItem> dialogs = new();
    private readonly List<ChatMessageItem> messages = new();
    private readonly List<DataLayer.Models.InteractionStatus> statuses = new();
    private int userId;
    private bool isAdmin;
    private bool isAgent;
    private bool isClient;
    private int selectedRealEstateId;
    private int selectedPeerId;
    private string selectedRealEstateAddress = string.Empty;
    [Parameter]
    [SupplyParameterFromQuery(Name = "realEstateId")]
    public int? RealEstateId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery(Name = "peerId")]
    public int? PeerId { get; set; }
    private string draft = string.Empty;
    private int messageRows = 2;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool isDisposed;
    private string? chatNotice;
    private string DialogSearch { get; set; } = string.Empty;
    private InteractionSummary? selectedInteraction;
    private int selectedStatusId;
    private bool isStatusSaving;
    private bool isDeletingDialog;
    private bool isDialogMenuOpen;
    private ElementReference messagesContainer;
    private ElementReference messageInput;
    private bool shouldScrollMessages;
    private bool CanEditSelectedInteraction => selectedInteraction is not null && (isAdmin || selectedInteraction.AgentId == userId);
    private string CurrentDialogUrl => selectedRealEstateId > 0 && selectedPeerId > 0
        ? $"/chat?realEstateId={selectedRealEstateId}&peerId={selectedPeerId}"
        : "/chat";
    private string SelectedObjectUrl => selectedRealEstateId > 0
        ? $"/real-estate/{selectedRealEstateId}?returnUrl={Uri.EscapeDataString(CurrentDialogUrl)}"
        : "/search";
    private IEnumerable<ChatDialogItem> FilteredDialogs => string.IsNullOrWhiteSpace(DialogSearch)
        ? dialogs
        : dialogs.Where(MatchesDialogSearch);

    private IEnumerable<ChatDialogGroup> FilteredDialogGroups => FilteredDialogs
        .GroupBy(d => new { d.PeerId, d.PeerName })
        .Select(group => new ChatDialogGroup(
            group.Key.PeerId,
            group.Key.PeerName,
            group.OrderByDescending(d => d.LastMessageAt).ToList()))
        .OrderByDescending(group => group.Dialogs.Max(d => d.LastMessageAt));

    private bool MatchesDialogSearch(ChatDialogItem dialog)
    {
        var term = DialogSearch.Trim();
        return dialog.PeerName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || dialog.RealEstateAddress.Contains(term, StringComparison.OrdinalIgnoreCase)
            || dialog.LastMessage.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsed) ? parsed : 0;
        isAdmin = state.User.IsInRole("admin");
        isAgent = state.User.IsInRole("agent");
        isClient = state.User.IsInRole("client");
        statuses.AddRange(await InteractionService.GetStatusesAsync());
        await ReloadDialogsAsync();
        await TryOpenFromQueryAsync();
        StartPolling();
    }

    private async Task ReloadDialogsAsync()
    {
        try
        {
            var updatedDialogs = await ChatService.GetDialogsAsync(userId);
            dialogs.Clear();
            dialogs.AddRange(updatedDialogs);
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось загрузить диалоги: {ex.Message}";
        }
    }

    private async Task OpenDialogAsync(int realEstateId, int peerId)
    {
        selectedRealEstateId = realEstateId;
        selectedPeerId = peerId;
        var dialog = dialogs.FirstOrDefault(d => d.RealEstateId == realEstateId && d.PeerId == peerId);
        selectedRealEstateAddress = dialog?.RealEstateAddress ?? string.Empty;
        chatNotice = null;
        await ReloadMessagesAsync();
    }

    private static string GetDialogKey(ChatDialogItem dialog) => $"{dialog.RealEstateId}:{dialog.PeerId}";

    private bool IsSelectedDialog(ChatDialogItem dialog)
    {
        return dialog.RealEstateId == selectedRealEstateId && dialog.PeerId == selectedPeerId;
    }

    protected override async Task OnParametersSetAsync()
    {
        await TryOpenFromQueryAsync();
    }

    private async Task TryOpenFromQueryAsync()
    {
        if (RealEstateId is > 0 && PeerId is > 0)
        {
            selectedRealEstateId = RealEstateId.Value;
            selectedPeerId = PeerId.Value;
            var dialog = dialogs.FirstOrDefault(d => d.RealEstateId == selectedRealEstateId && d.PeerId == selectedPeerId);
            selectedRealEstateAddress = dialog?.RealEstateAddress ?? string.Empty;
            chatNotice = null;
            await ReloadMessagesAsync();
        }
    }

    private async Task ReloadMessagesAsync()
    {
        if (selectedRealEstateId <= 0 || selectedPeerId <= 0) return;
        try
        {
            var loadedMessages = await ChatService.GetMessagesAsync(userId, selectedRealEstateId, selectedPeerId);
            var lastKnownMessageId = messages.LastOrDefault()?.Id;
            var lastLoadedMessageId = loadedMessages.LastOrDefault()?.Id;
            if (messages.Count != loadedMessages.Count || lastKnownMessageId != lastLoadedMessageId)
            {
                shouldScrollMessages = true;
            }
            messages.Clear();
            messages.AddRange(loadedMessages);
            await ChatService.MarkAsReadAsync(userId, selectedRealEstateId, selectedPeerId);
            selectedInteraction = await InteractionService.GetDialogInteractionAsync(userId, selectedRealEstateId, selectedPeerId, isAdmin);
            if (string.IsNullOrWhiteSpace(selectedRealEstateAddress) && selectedInteraction is not null)
            {
                selectedRealEstateAddress = selectedInteraction.RealEstate;
            }
            selectedStatusId = selectedInteraction?.StatusId ?? statuses.FirstOrDefault()?.Id ?? 0;
            await ReloadDialogsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось загрузить сообщения: {ex.Message}";
        }
    }

    private async Task SendAsync()
    {
        if (userId <= 0)
        {
            chatNotice = "Не удалось определить текущего пользователя. Перезайдите в систему.";
            return;
        }

        if (selectedRealEstateId <= 0 || selectedPeerId <= 0)
        {
            chatNotice = "Сначала выберите диалог.";
            return;
        }

        if (selectedPeerId == userId)
        {
            chatNotice = "Нельзя отправить сообщение самому себе.";
            return;
        }

        var messageText = await GetDraftFromInputAsync();
        if (string.IsNullOrWhiteSpace(messageText)) return;
        try
        {
            await ChatService.SendAsync(selectedRealEstateId, userId, selectedPeerId, messageText.Trim());
            draft = string.Empty;
            messageRows = 2;
            await JS.InvokeVoidAsync("arhChat.clearValue", messageInput);
            chatNotice = null;
            await ReloadMessagesAsync();
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось отправить сообщение: {ex.Message}";
        }
    }

    private async Task HandleMessageKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await SendAsync();
        }
    }

    private void OnMessageInput(ChangeEventArgs args)
    {
        draft = args.Value?.ToString() ?? string.Empty;
        var lines = draft.Split('\n').Length;
        messageRows = Math.Clamp(lines, 2, 8);
    }

    private async Task<string> GetDraftFromInputAsync()
    {
        try
        {
            return await JS.InvokeAsync<string>("arhChat.getValue", messageInput);
        }
        catch
        {
            return draft;
        }
    }

    private async Task UpdateInteractionStatusAsync()
    {
        if (selectedInteraction is null || selectedStatusId <= 0 || isStatusSaving)
        {
            return;
        }

        try
        {
            isStatusSaving = true;
            await InteractionService.UpdateStatusAsync(new InteractionUpdateRequest
            {
                InteractionId = selectedInteraction.Id,
                StatusId = selectedStatusId,
                Notes = selectedInteraction.Notes
            }, userId, isAdmin);

            chatNotice = "Статус взаимодействия обновлён.";
            await ReloadMessagesAsync();
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось изменить статус: {ex.Message}";
        }
        finally
        {
            isStatusSaving = false;
        }
    }

    private async Task DeleteSelectedDialogAsync()
    {
        if (selectedRealEstateId <= 0 || selectedPeerId <= 0 || isDeletingDialog)
        {
            return;
        }

        try
        {
            isDeletingDialog = true;
            await ChatService.DeleteDialogAsync(userId, selectedRealEstateId, selectedPeerId);
            selectedRealEstateId = 0;
            selectedPeerId = 0;
            selectedRealEstateAddress = string.Empty;
            selectedInteraction = null;
            messages.Clear();
            chatNotice = "Диалог удалён.";
            NavigationManager.NavigateTo("/chat");
            await ReloadDialogsAsync();
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось удалить диалог: {ex.Message}";
        }
        finally
        {
            isDeletingDialog = false;
        }
    }

    private void ToggleDialogMenu()
    {
        isDialogMenuOpen = !isDialogMenuOpen;
    }

    private void BackToDialogs()
    {
        selectedRealEstateId = 0;
        selectedPeerId = 0;
        selectedRealEstateAddress = string.Empty;
        selectedInteraction = null;
        messages.Clear();
        isDialogMenuOpen = false;
        chatNotice = null;
        NavigationManager.NavigateTo("/chat");
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldScrollMessages || selectedRealEstateId <= 0)
        {
            return;
        }

        shouldScrollMessages = false;
        await JS.InvokeVoidAsync("arhChat.scrollToBottom", messagesContainer);
    }
    private void StartPolling()
    {
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = Task.Run(async () =>
        {
            try
            {
                while (!isDisposed && timer is not null && await timer.WaitForNextTickAsync(cts.Token))
                {
                    if (isDisposed) break;
                    await InvokeAsync(async () =>
                    {
                        if (isDisposed) return;
                        if (selectedRealEstateId > 0 && selectedPeerId > 0)
                        {
                            await ReloadMessagesAsync();
                        }
                        else
                        {
                            await ReloadDialogsAsync();
                        }
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Нормальная остановка polling при dispose.
            }
            catch (ObjectDisposedException)
            {
                // Компонент/таймер уже освобождён.
            }
            catch (Exception ex)
            {
                await InvokeAsync(() => chatNotice = $"Ошибка обновления чата: {ex.Message}");
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
        timer?.Dispose();
    }

    private sealed record ChatDialogGroup(int ClientId, string ClientName, IReadOnlyList<ChatDialogItem> Dialogs);
}







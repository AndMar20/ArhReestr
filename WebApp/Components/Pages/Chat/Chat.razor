@page "/chat"
@attribute [Authorize(Roles = "agent,client,admin")]
@using global::System.Security.Claims
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatService ChatService

<PageTitle>Чаты</PageTitle>

<section class="hero-card">
    <div class="section-header">
        <h1 class="section-title">Чаты по объектам</h1>
    </div>
</section>

<div class="grid" style="grid-template-columns: 320px 1fr; gap:1rem;">
    <article class="panel">
        <h2>Диалоги</h2>
        @if (dialogs.Count == 0)
        {
            <p class="small-text">Диалогов пока нет.</p>
        }
        else
        {
            <ul class="list-clean">
                @foreach (var d in dialogs)
                {
                    <li>
                        <button class="ghost" style="width:100%;text-align:left;" @onclick="() => OpenDialogAsync(d.RealEstateId, d.PeerId)">
                            <strong>@d.PeerName</strong><br />
                            <span class="small-text">@d.RealEstateAddress</span><br />
                            <span class="small-text">@d.LastMessage</span>
                            @if (d.HasUnread) { <span class="badge accent">new</span> }
                        </button>
                    </li>
                }
            </ul>
        }
    </article>

    <article class="panel">
        @if (!string.IsNullOrWhiteSpace(chatNotice))
        {
            <div class="alert info">@chatNotice</div>
        }

        @if (selectedRealEstateId == 0)
        {
            <p class="small-text">Выберите диалог слева.</p>
        }
        else
        {
            <div class="section-header">
                <h2>Сообщения</h2>
            </div>
            <div style="max-height:420px;overflow:auto;display:grid;gap:.5rem;">
                @foreach (var m in messages)
                {
                    <div style="display:flex;justify-content:@(m.SenderId == userId ? "flex-start" : "flex-end");">
                    <div class="@(m.SenderId == userId ? "badge accent" : "badge")" style="max-width:75%;">
                        @m.Message
                        <div class="small-text">@m.SentAt.ToString("g") · @(m.ReadAt.HasValue ? "прочитано" : "доставлено")</div>
                    </div>
                    </div>
                }
            </div>

            <div class="form-stack">
                <textarea class="input-textarea" value="@draft" @oninput="OnMessageInput" rows="@messageRows" style="resize:none;overflow:hidden;"></textarea>
                <button type="button" class="primary" disabled="string.IsNullOrWhiteSpace(draft)" @onclick="SendAsync">Отправить</button>
            </div>
        }
    </article>
</div>

@code {
    private readonly List<ChatDialogItem> dialogs = new();
    private readonly List<ChatMessageItem> messages = new();
    private int userId;
    private int selectedRealEstateId;
    private int selectedPeerId;
    [Parameter]
    [SupplyParameterFromQuery(Name = "realEstateId")]
    public int? RealEstateId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery(Name = "peerId")]
    public int? PeerId { get; set; }
    private string draft = string.Empty;
    private int messageRows = 2;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool isDisposed;
    private string? chatNotice;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsed) ? parsed : 0;
        await ReloadDialogsAsync();
        await TryOpenFromQueryAsync();
        StartPolling();
    }

    private async Task ReloadDialogsAsync()
    {
        try
        {
            dialogs.Clear();
            dialogs.AddRange(await ChatService.GetDialogsAsync(userId));
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось загрузить диалоги: {ex.Message}";
        }
    }

    private async Task OpenDialogAsync(int realEstateId, int peerId)
    {
        selectedRealEstateId = realEstateId;
        selectedPeerId = peerId;
        await ReloadMessagesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await TryOpenFromQueryAsync();
    }

    private async Task TryOpenFromQueryAsync()
    {
        if (RealEstateId is > 0 && PeerId is > 0)
        {
            selectedRealEstateId = RealEstateId.Value;
            selectedPeerId = PeerId.Value;
            chatNotice = "Можно сразу написать первое сообщение в этом диалоге.";
            await ReloadMessagesAsync();
        }
    }

    private async Task ReloadMessagesAsync()
    {
        if (selectedRealEstateId <= 0 || selectedPeerId <= 0) return;
        try
        {
            messages.Clear();
            messages.AddRange(await ChatService.GetMessagesAsync(userId, selectedRealEstateId, selectedPeerId));
            await ChatService.MarkAsReadAsync(userId, selectedRealEstateId, selectedPeerId);
            await ReloadDialogsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось загрузить сообщения: {ex.Message}";
        }
    }

    private async Task SendAsync()
    {
        if (userId <= 0)
        {
            chatNotice = "Не удалось определить текущего пользователя. Перезайдите в систему.";
            return;
        }

        if (selectedRealEstateId <= 0 || selectedPeerId <= 0)
        {
            chatNotice = "Сначала выберите диалог.";
            return;
        }

        if (selectedPeerId == userId)
        {
            chatNotice = "Нельзя отправить сообщение самому себе.";
            return;
        }

        if (string.IsNullOrWhiteSpace(draft)) return;
        try
        {
            await ChatService.SendAsync(selectedRealEstateId, userId, selectedPeerId, draft.Trim());
            draft = string.Empty;
            messageRows = 2;
            chatNotice = null;
            await ReloadMessagesAsync();
        }
        catch (Exception ex)
        {
            chatNotice = $"Не удалось отправить сообщение: {ex.Message}";
        }
    }

    private void OnMessageInput(ChangeEventArgs args)
    {
        draft = args.Value?.ToString() ?? string.Empty;
        var lines = draft.Split('\n').Length;
        messageRows = Math.Clamp(lines, 2, 8);
    }

    private void StartPolling()
    {
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = Task.Run(async () =>
        {
            try
            {
                while (!isDisposed && timer is not null && await timer.WaitForNextTickAsync(cts.Token))
                {
                    if (isDisposed) break;
                    await InvokeAsync(async () =>
                    {
                        if (isDisposed) return;
                        await ReloadDialogsAsync();
                        await ReloadMessagesAsync();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Нормальная остановка polling при dispose.
            }
            catch (ObjectDisposedException)
            {
                // Компонент/таймер уже освобождён.
            }
            catch (Exception ex)
            {
                await InvokeAsync(() => chatNotice = $"Ошибка обновления чата: {ex.Message}");
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
        timer?.Dispose();
    }
}

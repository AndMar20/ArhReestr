@page "/Error"
@using global::System.Diagnostics

<PageTitle>Ошибка</PageTitle>

<section class="global-error-card page-error" role="alert">
    <div>
        <p class="eyebrow">Ошибка приложения</p>
        <h1>Возникла непредвиденная ошибка</h1>
        <p>Попробуйте обновить страницу или вернуться в каталог. Если ошибка повторится, передайте администратору номер запроса.</p>
        @if (ShowRequestId)
        {
            <p class="muted">Номер запроса: <code>@RequestId</code></p>
        }
    </div>
    <div class="global-error-actions">
        <a href="/" class="primary">В каталог</a>
        <a href="" class="ghost">Обновить страницу</a>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

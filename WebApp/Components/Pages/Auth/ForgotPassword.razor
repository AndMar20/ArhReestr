@page "/forgot-password"
@using DataLayer
@using Microsoft.EntityFrameworkCore
@using global::System.ComponentModel.DataAnnotations
@inject IDbContextFactory<ArhReestrContext> DbFactory
@inject NotificationService NotificationService

<PageTitle>Восстановление пароля</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="brand">
            <img class="auth-logo" height="50" width="100" src="Images/Logo/app-logo.png" alt="Логотип АрхРеестр" />
        </div>
        <h1 class="auth-title">Восстановление пароля</h1>
        <p class="auth-sub">Оставьте запрос. Администратор проверит данные и поможет восстановить доступ.</p>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @MessageStyle">@Message</div>
        }

        <EditForm Model="Model" OnValidSubmit="SendRequestAsync" class="form-stack" FormName="forgotPasswordForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>Email
                <InputText @bind-Value="Model.Email" type="email" />
            </label>
            <label>Телефон
                <InputText @bind-Value="Model.Phone" type="tel" />
            </label>

            <button type="submit" disabled="@IsSaving">@(IsSaving ? "Отправляем..." : "Отправить запрос")</button>
        </EditForm>

        <NavLink href="/login" class="footer-link">Вернуться ко входу</NavLink>
    </div>
</div>

@code {
    private readonly ForgotPasswordModel Model = new();
    private string? Message;
    private string MessageStyle = "info";
    private bool IsSaving;

    private async Task SendRequestAsync()
    {
        IsSaving = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var user = await context.Users
                .AsNoTracking()
                .FirstOrDefaultAsync(item => item.Email == Model.Email.Trim());

            if (user is not null && PhoneMatches(user.Phone, Model.Phone))
            {
                var admins = await context.Users
                    .AsNoTracking()
                    .Where(item => item.Role != null && item.Role.Name == "admin" && item.DeletedAt == null)
                    .Select(item => item.Id)
                    .ToListAsync();

                foreach (var adminId in admins)
                {
                    await NotificationService.CreateAsync(
                        adminId,
                        "Запрос восстановления пароля",
                        $"{FullNameFormatter.Combine(user.LastName, user.FirstName, user.MiddleName)} просит восстановить доступ.",
                        "/admin/users");
                }
            }

            Message = "Если данные найдены, администратор получит запрос на восстановление доступа.";
            MessageStyle = "success";
            Model.Email = string.Empty;
            Model.Phone = string.Empty;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static bool PhoneMatches(string? storedPhone, string enteredPhone)
    {
        static string Normalize(string? value) => new(value?.Where(char.IsDigit).ToArray() ?? []);
        return Normalize(storedPhone) == Normalize(enteredPhone);
    }

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Введите корректный email")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите телефон")]
        public string Phone { get; set; } = string.Empty;
    }
}

@page "/"
@page "/search"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using global::System.Globalization
@using global::System.Linq
@using global::System.Security.Claims
@implements IDisposable
@inject RealEstateService RealEstateService
@inject InteractionService InteractionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject FavoriteService FavoriteService
@inject IJSRuntime JS

<PageTitle>Каталог объектов</PageTitle>

<section class="hero-card">
        <div class="section-header hero-header">
            <div>
                <h1 class="section-title">Поиск недвижимости</h1>
                <p class="section-sub">Выберите район, параметры жилья и оставьте заявку на консультацию с риелтором.</p>
            </div>
            <div class="hero-actions">
                <div class="segmented-control" role="group" aria-label="Режим отображения">
                    <button type="button" class='@GetSegmentedClass("cards")' @onclick='() => SetViewMode("cards")'>Карточки</button>
                    <button type="button" class='@GetSegmentedClass("map")' @onclick='() => SetViewMode("map")'>Карта</button>
                </div>
                <div class="tag-pill action">@StatusText</div>
            </div>
        </div>

    <EditForm EditContext="filterContext" class="catalog-search-form" FormName="realEstateFilterForm" OnValidSubmit="OnFilterAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="catalog-filter-bar">
            <label>Район
                <InputSelect @bind-Value="Filter.DistrictId">
                    <option value="">Все районы</option>
                    @foreach (var district in Districts)
                    {
                        <option value="@district.Id">@district.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Тип
                <InputSelect @bind-Value="Filter.TypeId">
                    <option value="">Все типы</option>
                    @foreach (var type in Types)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Сортировка
                <select value="@SortPreset" @onchange="OnSortPresetChanged">
                    <option value="price_asc">Сначала дешевле</option>
                    <option value="price_desc">Сначала дороже</option>
                    <option value="area_desc">Больше площадь</option>
                    <option value="area_asc">Меньше площадь</option>
                    <option value="rooms_asc">Меньше комнат</option>
                    <option value="district_asc">По району</option>
                </select>
            </label>
            <button class="ghost filter-more-button" type="button" @onclick="ToggleFilters">
                Ещё фильтры
                @if (AdvancedFilterCount > 0)
                {
                    <span class="filter-count">@AdvancedFilterCount</span>
                }
            </button>
            <button class="ghost filter-reset-button" type="button" @onclick="ResetFiltersAsync" disabled="@IsLoading">Сбросить параметры</button>
        </div>

        @if (filtersVisible)
        {
            <div class="filter-drawer-backdrop" @onclick="ToggleFilters">
                <div class="filter-drawer" @onclick:stopPropagation="true">
                    <div class="section-header">
                        <div>
                            <h2>Дополнительные фильтры</h2>
                            <p class="section-sub">Параметры применяются автоматически.</p>
                        </div>
                        <button type="button" class="ghost" @onclick="ToggleFilters">Закрыть</button>
                    </div>
                    <div class="advanced-filters">
                        <label>Цена от
                            <input type="number" value="@Filter.MinPrice" min="0" step="50000" @oninput="OnMinPriceInputAsync" />
                            <ValidationMessage For="@(() => Filter.MinPrice)" />
                        </label>
                        <label>Цена до
                            <input type="number" value="@Filter.MaxPrice" min="0" step="50000" @oninput="OnMaxPriceInputAsync" />
                            <ValidationMessage For="@(() => Filter.MaxPrice)" />
                        </label>
                        <label>Комнаты
                            <input type="number" value="@Filter.Rooms" min="0" step="1" @oninput="OnRoomsInputAsync" />
                            <ValidationMessage For="@(() => Filter.Rooms)" />
                        </label>
                        <label>Площадь от
                            <input type="number" value="@Filter.MinArea" min="0" step="0.01" @oninput="OnMinAreaInputAsync" />
                            <ValidationMessage For="@(() => Filter.MinArea)" />
                        </label>
                        <label>Площадь до
                            <input type="number" value="@Filter.MaxArea" min="0" step="0.01" @oninput="OnMaxAreaInputAsync" />
                            <ValidationMessage For="@(() => Filter.MaxArea)" />
                        </label>
                        <label class="checkbox-inline filter-check">
                            <InputCheckbox class="checkbox-control" @bind-Value="balconyRequired" @onchange="ScheduleFilterAsync" />
                            <span>Балкон</span>
                        </label>
                        <label class="checkbox-inline filter-check">
                            <InputCheckbox class="checkbox-control" @bind-Value="parkingRequired" @onchange="ScheduleFilterAsync" />
                            <span>Парковка</span>
                        </label>
                        <label class="checkbox-inline filter-check">
                            <InputCheckbox class="checkbox-control" @bind-Value="elevatorRequired" @onchange="ScheduleFilterAsync" />
                            <span>Лифт</span>
                        </label>
                    </div>
                    <div class="actions-row">
                        <button type="button" class="ghost" @onclick="ResetFiltersAsync" disabled="@IsLoading">Сбросить фильтры</button>
                    </div>
                </div>
            </div>
        }
    </EditForm>
</section>

@if (!string.IsNullOrEmpty(Notification))
{
    <div class="alert @NotificationStyle">@Notification</div>
}

@if (IsLoading)
{
    <p>Загрузка...</p>
}
else if (hasLoaded && Results.Count == 0)
{
    <p>Предложения не найдены.</p>
}
else
{
    <div class="panel" style="margin-top:1.5rem;">
        <div class="section-header">
            <h2>Объекты</h2>
            <span class="small-text">@ResultsStatusText</span>
        </div>

        @if (viewMode == "cards")
        {
            <div class="cards">
                @foreach (var item in Results)
                {
                    <article class="card">
                        @if (!string.IsNullOrEmpty(item.PrimaryPhoto))
                        {
                            <a class="card-photo" href="@BuildObjectUrl(item.Id)">
                                <img src="@item.PrimaryPhoto" alt="Фото объекта" />
                            </a>
                        }
                        <div class="card-content">
                            <div class="meta-line">
                                <span class="tag-pill primary">@item.Type</span>
                                <span class="tag-pill">@item.District</span>
                            </div>

                            <h2>@item.Address</h2>

                            <div class="meta-line">
                                <span>@item.Rooms-комн. · @item.Area м²</span>
                                <span>Этаж @item.Floor/@item.TotalFloors</span>
                            </div>

                            <p class="price">@item.Price.ToString("N0") ₽</p>

                            <div class="meta-line" >
                                <div class="tags">
                                    @if (item.HasBalcony)
                                    {
                                        <span class="tag-pill">Балкон</span>
                                    }
                                    @if (item.HasParking)
                                    {
                                        <span class="tag-pill">Парковка</span>
                                    }
                                    @if (item.HasElevator)
                                    {
                                        <span class="tag-pill">Лифт</span>
                                    }
                                </div>
                            </div>

                            <div class="card-actions @(CanRequestInteraction ? string.Empty : "no-request-action")">
                                @if (CanRequestInteraction)
                                {
                                    <button @onclick="() => ContactAsync(item)"
                                            disabled="@(IsLoading || pendingFilter || contactingItems.Contains(item.Id))"
                                            class="@(activeRequestIds.ContainsKey(item.Id) ? "danger" : string.Empty)">
                                        @(GetInteractionButtonText(item.Id))
                                    </button>
                                }

                                <button class="icon-button favorite-button @(favoriteIds.Contains(item.Id) ? "active" : string.Empty)"
                                        @onclick="() => ToggleFavoriteAsync(item.Id)"
                                        disabled="@(IsLoading || pendingFilter)">
                                    <span aria-hidden="true">★</span>
                                    <span class="sr-only">
                                        @(favoriteIds.Contains(item.Id) ? "Убрать из избранного" : "Добавить в избранное")
                                    </span>
                                </button>

                                <a class="ghost" href="@BuildObjectUrl(item.Id)">Подробнее</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            var mapItems = MapItems.ToList();

            @if (isMapLoading)
            {
                <p>Загрузка объектов на карте...</p>
            }
            else if (mapItems.Count == 0)
            {
                <div class="empty-map">
                    <h3>Нет объектов с координатами</h3>
                    <p class="section-sub">Для отображения на карте у объекта должны быть заполнены широта и долгота.</p>
                </div>
            }
            else
            {
                <div class="catalog-map">
                    <div id="catalog-map-canvas"></div>
                </div>
            }
        }
    </div>
}

@if (Results.Any() && viewMode != "map")
{
    <div class="actions-row" style="margin:0.5rem 0 0;">
        <div class="badge">Страница @Filter.Page из @(TotalPages == 0 ? 1 : TotalPages)</div>
        <div class="badge accent">Режим: @ViewModeLabel</div>
        <div class="buttons">
            <button @onclick="PreviousPageAsync" disabled="@(IsLoading || !HasPreviousPage)">Предыдущая</button>
            <button @onclick="NextPageAsync" disabled="@(IsLoading || !HasNextPage)">Следующая</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewModeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "districtId")]
    public int? DistrictIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "streetId")]
    public int? StreetIdQuery { get; set; }

    private readonly RealEstateFilterModel Filter = new();
    private readonly List<RealEstateSummary> Results = new();
    private readonly List<RealEstateSummary> MapResults = new();
    private EditContext? filterContext;
    private CancellationTokenSource? filterDelayCts;
    private List<DataLayer.Models.District> Districts { get; set; } = new();
    private List<DataLayer.Models.RealEstateType> Types { get; set; } = new();
    private bool IsLoading;
    private string? Notification;
    private string NotificationStyle = "info";
    private bool balconyRequired;
    private bool parkingRequired;
    private bool elevatorRequired;
    private bool hasLoaded;
    private bool pendingFilter;
    private bool isDebouncingFilter;
    private bool filtersVisible = false;
    private bool CanRequestInteraction = true;
    private bool isMapLoading;
    private bool shouldRenderMap;
    private int TotalResults;
    private string sortDirection = "asc";
    private string SortPreset = "price_asc";
    private string viewMode = "cards";
    private const int FilterDelayMs = 400;
    private string AveragePriceText => Results.Count == 0 ? "—" : $"{(int)Results.Average(r => r.Price):N0} ₽";
    private string AverageAreaText => Results.Count == 0 ? "—" : $"{Results.Average(r => r.Area):0.#} м²";
    private string PopularDistrict => Results.Count == 0 ? "—" : Results
        .GroupBy(r => r.District)
        .OrderByDescending(g => g.Count())
        .First().Key;
    private int AdvancedFilterCount =>
        (Filter.MinPrice.HasValue ? 1 : 0) +
        (Filter.MaxPrice.HasValue ? 1 : 0) +
        (Filter.Rooms.HasValue ? 1 : 0) +
        (Filter.MinArea.HasValue ? 1 : 0) +
        (Filter.MaxArea.HasValue ? 1 : 0) +
        (balconyRequired ? 1 : 0) +
        (parkingRequired ? 1 : 0) +
        (elevatorRequired ? 1 : 0);
    private string StatusText => IsLoading
        ? "Загрузка..."
        : pendingFilter
            ? "Применяем фильтры..."
            : isDebouncingFilter
                ? "Ожидаем завершения ввода..."
                : $"Найдено: {TotalResults}";
    private int TotalPages => TotalResults == 0 ? 0 : (int)Math.Ceiling((double)TotalResults / Filter.PageSize);
    private bool HasNextPage => TotalPages > 0 && Filter.Page < TotalPages;
    private bool HasPreviousPage => Filter.Page > 1;
    private string PaginationStatus => TotalResults == 0 ? "нет результатов" : $"страница {Filter.Page} из {TotalPages}";
    private string ResultsStatusText => viewMode == "map"
        ? $"{MapItems.Count()} на карте · всего {TotalResults}"
        : $"{TotalResults} записей · {PaginationStatus}";
    private string ViewModeLabel => viewMode switch
    {
        "map" => "карта",
        _ => "карточки"
    };
    private IEnumerable<RealEstateSummary> MapItems => MapResults.Where(r => r.Latitude.HasValue && r.Longitude.HasValue);
    private readonly HashSet<int> favoriteIds = new();
    private readonly Dictionary<int, int> activeRequestIds = new();
    private const decimal DefaultRate = 9.5m;
    private const int DefaultYears = 20;
    private const decimal DefaultDownPaymentShare = 0.2m;

    protected override void OnInitialized()
    {
        viewMode = NormalizeViewMode(ViewModeQuery);
        Filter.DistrictId = DistrictIdQuery;
        Filter.StreetId = StreetIdQuery;
        Filter.PageSize = 15;
        filterContext = new EditContext(Filter);
        filterContext.EnableDataAnnotationsValidation();
        filterContext.OnFieldChanged += OnFilterFieldChanged;
    }

    private async Task SetViewMode(string mode)
    {
        viewMode = NormalizeViewMode(mode);
        if (viewMode == "map")
        {
            await LoadMapAsync();
            shouldRenderMap = true;
        }
    }

    private string GetSegmentedClass(string mode)
    {
        return viewMode == mode ? "segment active" : "segment";
    }

    private void ToggleFilters()
    {
        filtersVisible = !filtersVisible;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? "client";
            CanRequestInteraction = state.User.Identity?.IsAuthenticated != true || role is "client" or "admin";
            Districts = (await RealEstateService.GetDistrictsAsync()).ToList();
            Types = (await RealEstateService.GetTypesAsync()).ToList();

            await LoadAsync();
            if (viewMode == "map")
            {
                await LoadMapAsync();
                shouldRenderMap = true;
            }
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            if (IsLoading)
            {
                IsLoading = false;
            }

            if (!hasLoaded)
            {
                hasLoaded = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadFavoritesAsync();
            StateHasChanged();
        }

        if (shouldRenderMap && viewMode == "map")
        {
            shouldRenderMap = false;
            await RenderMapAsync();
        }
    }

    private readonly HashSet<int> contactingItems = new();

    private async Task ScheduleFilterAsync(ChangeEventArgs? _ = null)
    {
        filterDelayCts?.Cancel();
        filterDelayCts?.Dispose();

        filterDelayCts = new CancellationTokenSource();
        var token = filterDelayCts.Token;
        isDebouncingFilter = true;

        try
        {
            await Task.Delay(FilterDelayMs, token);
            await OnFilterAsync();
        }
        catch (TaskCanceledException)
        {
            // intentionally ignored
        }
    }

    private Task OnMinPriceInputAsync(ChangeEventArgs args)
    {
        Filter.MinPrice = ParseDecimal(args.Value);
        Filter.Page = 1;
        return ScheduleFilterAsync();
    }

    private Task OnMaxPriceInputAsync(ChangeEventArgs args)
    {
        Filter.MaxPrice = ParseDecimal(args.Value);
        Filter.Page = 1;
        return ScheduleFilterAsync();
    }

    private Task OnMinAreaInputAsync(ChangeEventArgs args)
    {
        Filter.MinArea = ParseDecimal(args.Value);
        Filter.Page = 1;
        return ScheduleFilterAsync();
    }

    private Task OnMaxAreaInputAsync(ChangeEventArgs args)
    {
        Filter.MaxArea = ParseDecimal(args.Value);
        Filter.Page = 1;
        return ScheduleFilterAsync();
    }

    private Task OnRoomsInputAsync(ChangeEventArgs args)
    {
        Filter.Rooms = ParseInt(args.Value);
        Filter.Page = 1;
        return ScheduleFilterAsync();
    }

    private static decimal? ParseDecimal(object? value)
    {
        var text = value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        text = text.Replace(',', '.');
        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;
    }

    private static int? ParseInt(object? value)
    {
        var text = value?.ToString();
        return int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;
    }

    private void OnFilterFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        Filter.Page = 1;
        if (e.FieldIdentifier.FieldName == nameof(Filter.SortBy))
        {
            return;
        }

        _ = ScheduleFilterAsync();
    }

    private async Task OnFilterAsync()
    {
        Filter.HasBalcony = balconyRequired ? true : null;
        Filter.HasParking = parkingRequired ? true : null;
        Filter.HasElevator = elevatorRequired ? true : null;
        Filter.SortDescending = sortDirection == "desc";

        Filter.Page = 1;

        if (filterContext is not null && !filterContext.Validate())
        {
            isDebouncingFilter = false;
            return;
        }

        if (IsLoading)
        {
            pendingFilter = true;
            return;
        }

        isDebouncingFilter = false;
        await LoadAsync();
    }

    private Task ApplyQuickFilterAsync(int? rooms, bool? balcony, bool? parking, bool? elevator)
    {
        Filter.Rooms = rooms;
        balconyRequired = balcony ?? false;
        parkingRequired = parking ?? false;
        elevatorRequired = elevator ?? false;
        Filter.Page = 1;
        return OnFilterAsync();
    }

    private Task ResetFiltersAsync()
    {
        Filter.DistrictId = null;
        Filter.StreetId = null;
        Filter.TypeId = null;
        Filter.MinPrice = null;
        Filter.MaxPrice = null;
        Filter.MinArea = null;
        Filter.MaxArea = null;
        Filter.Rooms = null;

        // сортировка и пагинация
        Filter.SortBy = "price";
        Filter.SortDescending = false;
        Filter.Page = 1;
        Filter.PageSize = 15;
        sortDirection = "asc";
        SortPreset = "price_asc";

        // локальные чекбоксы
        balconyRequired = false;
        parkingRequired = false;
        elevatorRequired = false;

        // ОБЯЗАТЕЛЬНО: сбрасываем сами поля фильтра по удобствам
        Filter.HasBalcony = null;
        Filter.HasParking = null;
        Filter.HasElevator = null;

        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Notification = null;
        NotificationStyle = "info";
        Results.Clear();
        TotalResults = 0;

        try
        {
            var data = await RealEstateService.SearchAsync(Filter);
            Results.AddRange(data.Items);
            TotalResults = data.TotalCount;
            Filter.Page = data.Page;
            Filter.PageSize = data.PageSize;
            if (TotalPages > 0 && Filter.Page > TotalPages)
            {
                Filter.Page = TotalPages;
                await LoadAsync();
                return;
            }

            if (viewMode == "map")
            {
                await LoadMapAsync();
                shouldRenderMap = true;
            }

            await LoadActiveRequestsAsync();
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsLoading = false;
            hasLoaded = true;
        }

        if (pendingFilter)
        {
            pendingFilter = false;
            await OnFilterAsync();
        }
    }

    private async Task LoadFavoritesAsync()
    {
        try
        {
            favoriteIds.Clear();
            var persisted = await FavoriteService.GetAsync();
            foreach (var id in persisted)
            {
                favoriteIds.Add(id);
            }
        }
        catch
        {
            Notification ??= "Не удалось восстановить избранное";
            NotificationStyle = "error";
        }
    }

    private async Task LoadActiveRequestsAsync()
    {
        activeRequestIds.Clear();

        if (!CanRequestInteraction || Results.Count == 0)
        {
            return;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var userIdString = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdString, out var userId))
        {
            return;
        }

        foreach (var item in Results)
        {
            var requestId = await InteractionService.GetActiveInteractionIdAsync(userId, item.Id);
            if (requestId.HasValue)
            {
                activeRequestIds[item.Id] = requestId.Value;
            }
        }
    }

    private string GetInteractionButtonText(int realEstateId)
    {
        if (contactingItems.Contains(realEstateId))
        {
            return "Обработка...";
        }

        return activeRequestIds.ContainsKey(realEstateId)
            ? "Отменить заявку"
            : "Оставить заявку";
    }

    private async Task ContactAsync(RealEstateSummary item)
    {
        if (contactingItems.Contains(item.Id))
        {
            return;
        }

        contactingItems.Add(item.Id);

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(BuildCatalogReturnUrl())}");
            contactingItems.Remove(item.Id);
            return;
        }

        var userIdString = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(userIdString, out var userId))
        {
            Notification = "Не удалось определить пользователя";
            NotificationStyle = "error";
            contactingItems.Remove(item.Id);
            return;
        }

        var role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? "client";
        if (role is not ("client" or "admin"))
        {
            Notification = "Только клиенты могут отправлять заявки";
            NotificationStyle = "error";
            contactingItems.Remove(item.Id);
            return;
        }

        try
        {
            if (activeRequestIds.ContainsKey(item.Id))
            {
                await InteractionService.CancelByClientAndEstateAsync(userId, item.Id);
                activeRequestIds.Remove(item.Id);
                Notification = "Заявка отменена.";
            }
            else
            {
                var requestId = await InteractionService.CreateInteractionAsync(userId, item.AgentId, item.Id, "Заявка из каталога");
                activeRequestIds[item.Id] = requestId;
                Notification = "Заявка отправлена. Контакты риелтора отображаются в кабинете клиента.";
            }
            NotificationStyle = "success";
        }
        catch (Exception)
        {
            Notification = "Заявка уже существует или недоступна.";
            NotificationStyle = "error";
        }
        finally
        {
            contactingItems.Remove(item.Id);
        }
    }

    private Task OnSortChanged(ChangeEventArgs _)
    {
        Filter.Page = 1;
        Filter.SortDescending = sortDirection == "desc";
        return OnFilterAsync();
    }

    private Task OnSortPresetChanged(ChangeEventArgs args)
    {
        SortPreset = args.Value?.ToString() ?? "price_asc";
        ApplySortPreset();
        Filter.Page = 1;
        return OnFilterAsync();
    }

    private void ApplySortPreset()
    {
        var parts = SortPreset.Split('_', 2, StringSplitOptions.RemoveEmptyEntries);
        Filter.SortBy = parts.ElementAtOrDefault(0) ?? "price";
        sortDirection = parts.ElementAtOrDefault(1) == "desc" ? "desc" : "asc";
        Filter.SortDescending = sortDirection == "desc";
    }

    private Task OnSortDirectionChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? "asc";
        sortDirection = value;
        Filter.SortDescending = value == "desc";
        Filter.Page = 1;
        return OnFilterAsync();
    }

    private Task OnAmenitiesChangedAsync(ChangeEventArgs _)
    {
        return OnFilterAsync();
    }

    private Task PreviousPageAsync()
    {
        if (!HasPreviousPage)
        {
            return Task.CompletedTask;
        }

        Filter.Page -= 1;
        return LoadAsync();
    }

    private Task NextPageAsync()
    {
        if (!HasNextPage)
        {
            return Task.CompletedTask;
        }

        Filter.Page += 1;
        return LoadAsync();
    }

    private async Task LoadMapAsync()
    {
        if (isMapLoading)
        {
            return;
        }

        isMapLoading = true;
        MapResults.Clear();

        try
        {
            var mapFilter = CloneFilterForMap(1);
            PagedResult<RealEstateSummary>? page;
            do
            {
                page = await RealEstateService.SearchAsync(mapFilter);
                MapResults.AddRange(page.Items);
                mapFilter.Page++;
            }
            while (page.Items.Count > 0 && MapResults.Count < page.TotalCount);
        }
        finally
        {
            isMapLoading = false;
        }
    }

    private RealEstateFilterModel CloneFilterForMap(int page)
    {
        return new RealEstateFilterModel
        {
            DistrictId = Filter.DistrictId,
            StreetId = Filter.StreetId,
            TypeId = Filter.TypeId,
            MinPrice = Filter.MinPrice,
            MaxPrice = Filter.MaxPrice,
            MinArea = Filter.MinArea,
            MaxArea = Filter.MaxArea,
            Rooms = Filter.Rooms,
            HasBalcony = Filter.HasBalcony,
            HasParking = Filter.HasParking,
            HasElevator = Filter.HasElevator,
            SortBy = Filter.SortBy,
            SortDescending = Filter.SortDescending,
            Page = page,
            PageSize = 200
        };
    }

    private async Task RenderMapAsync()
    {
        var mapItems = MapItems
            .Select(item => new
            {
                id = item.Id,
                latitude = item.Latitude,
                longitude = item.Longitude,
                address = item.Address,
                url = BuildObjectUrl(item.Id),
                price = item.Price.ToString("N0", CultureInfo.CurrentCulture) + " ₽",
                details = $"{item.District} · {item.Rooms}-комн. · {item.Area} м²"
            })
            .ToList();

        await JS.InvokeVoidAsync("catalogMap.render", "catalog-map-canvas", mapItems);
    }

    private async Task ToggleFavoriteAsync(int id)
    {
        try
        {
            var added = await FavoriteService.ToggleAsync(id);
            if (added)
            {
                favoriteIds.Add(id);
            }
            else
            {
                favoriteIds.Remove(id);
            }
        }
        catch
        {
            Notification = "Не удалось обновить избранное.";
            NotificationStyle = "error";
        }

        StateHasChanged();
    }

    private string BuildObjectUrl(int id) => $"/real-estate/{id}?returnUrl={Uri.EscapeDataString(BuildCatalogReturnUrl())}";

    private string BuildCatalogReturnUrl()
    {
        var query = new Dictionary<string, string?>();
        if (viewMode != "cards")
        {
            query["view"] = viewMode;
        }

        if (Filter.DistrictId is not null)
        {
            query["districtId"] = Filter.DistrictId.Value.ToString();
        }

        if (Filter.StreetId is not null)
        {
            query["streetId"] = Filter.StreetId.Value.ToString();
        }

        return query.Count == 0
            ? "/search"
            : Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/search", query);
    }

    private static string NormalizeViewMode(string? mode)
    {
        return mode is "map" ? mode : "cards";
    }

    private decimal CalculateMonthlyPayment(decimal price)
    {
        var principal = Math.Max(price * (1 - DefaultDownPaymentShare), 0);
        var monthlyRate = DefaultRate / 12 / 100;
        var months = DefaultYears * 12;
        var factor = (decimal)Math.Pow(1 + (double)monthlyRate, months);
        return monthlyRate == 0
            ? principal / months
            : principal * monthlyRate * factor / (factor - 1);
    }

    public void Dispose()
    {
        filterDelayCts?.Cancel();
        filterDelayCts?.Dispose();
        if (filterContext is not null)
        {
            filterContext.OnFieldChanged -= OnFilterFieldChanged;
        }
    }
}

@page "/real-estate/{Id:int}/edit"
@using global::System.Security.Claims
@using DataLayer.Models
@attribute [Authorize(Policy = "RequireAgent")]
@inject RealEstateService RealEstateService
@inject LookupService LookupService
@inject GeocodingService GeocodingService
@inject AddressSuggestionService AddressSuggestionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Редактирование объекта</PageTitle>

<section class="hero-card">
    <div class="section-header">
        <div>
            <h1 class="section-title">Редактировать объект недвижимости</h1>
            <p class="section-sub">Обновите параметры и добавьте новые фотографии при необходимости.</p>
        </div>
        <div class="hero-actions">
            @if (canEdit)
            {
                @if (confirmDeleteObject)
                {
                    <button type="button" class="danger" @onclick="DeleteObjectAsync" disabled="@IsSaving">Подтвердить удаление</button>
                    <button type="button" class="ghost" @onclick="CancelObjectDelete" disabled="@IsSaving">Отмена</button>
                }
                else
                {
                    <button type="button" class="ghost danger" @onclick="RequestObjectDelete" disabled="@IsSaving">Удалить объект</button>
                }
            }
            <button type="button" class="ghost" @onclick="GoBack">Вернуться</button>
        </div>
    </div>
</section>

@if (!string.IsNullOrEmpty(Notification))
{
    <div class="alert @NotificationStyle">@Notification</div>
}

@if (IsLoading)
{
    <p>Загрузка...</p>
}
else if (canEdit)
{
    <div class="panel edit-estate-panel">
        <EditForm Model="Model" OnValidSubmit="UpdateAsync" class="form-stack edit-estate-form" FormName="realEstateEditForm">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="two-col">
                <div class="form-stack">
                    <h2>Адрес и дом</h2>
                    <label>Поиск адреса
                        <input value="@AddressQuery" @oninput="OnAddressInputAsync" list="address-options-edit" placeholder="Начните вводить улицу, район или номер дома" />
                        <datalist id="address-options-edit">
                            @foreach (var suggestion in AddressSuggestions)
                            {
                                <option value="@suggestion.DisplayName"></option>
                            }
                        </datalist>
                    </label>
                    <label>Район
                        <input value="@DistrictQuery" @oninput="OnDistrictInput" list="district-options-edit" placeholder="Начните вводить район" />
                        <datalist id="district-options-edit">
                            @foreach (var district in Districts)
                            {
                                <option value="@district.Name"></option>
                            }
                        </datalist>
                        <ValidationMessage For="@(() => Model.DistrictId)" />
                    </label>
                    <label>Улица
                        <input value="@StreetQuery" @oninput="OnStreetInput" list="street-options-edit" placeholder="Начните вводить улицу" />
                        <datalist id="street-options-edit">
                            @foreach (var street in Streets)
                            {
                                <option value="@street.Name"></option>
                            }
                        </datalist>
                        <ValidationMessage For="@(() => Model.StreetId)" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(StreetQuery) && !Model.StreetId.HasValue)
                    {
                        <p class="small-text">Новая улица будет добавлена при сохранении объекта.</p>
                    }
                    <label>Номер дома
                        <InputText @bind-Value="Model.HouseNumber" />
                        <ValidationMessage For="@(() => Model.HouseNumber)" />
                    </label>
                    <div class="grid-2">
                        <label>Этажность дома
                            <InputNumber @bind-Value="Model.TotalFloors" min="1" />
                            <ValidationMessage For="@(() => Model.TotalFloors)" />
                        </label>
                        <label>Год постройки
                            <InputNumber @bind-Value="Model.BuildingYear" min="1800" max="2100" />
                            <ValidationMessage For="@(() => Model.BuildingYear)" />
                        </label>
                    </div>
                    <div class="grid-2">
                        <label>Широта
                            <InputNumber @bind-Value="Model.Latitude" step="0.0000001" />
                            <ValidationMessage For="@(() => Model.Latitude)" />
                        </label>
                        <label>Долгота
                            <InputNumber @bind-Value="Model.Longitude" step="0.0000001" />
                            <ValidationMessage For="@(() => Model.Longitude)" />
                        </label>
                    </div>
                    <button type="button" class="ghost" @onclick="FindCoordinatesAsync" disabled="@(IsSaving || IsGeocoding)">
                        @(IsGeocoding ? "Поиск на карте..." : "Найти координаты по адресу")
                    </button>
                    <div class="checkbox-row">
                        <label class="checkbox-inline">
                            <InputCheckbox class="checkbox-control" @bind-Value="Model.HasParking" />
                            <span>Парковка</span>
                        </label>
                        <label class="checkbox-inline">
                            <InputCheckbox class="checkbox-control" @bind-Value="Model.HasElevator" />
                            <span>Лифт</span>
                        </label>
                        <label class="checkbox-inline">
                            <InputCheckbox class="checkbox-control" @bind-Value="Model.HasBalcony" />
                            <span>Балкон</span>
                        </label>
                    </div>
                </div>
                <div class="form-stack">
                    <h2>Параметры объекта</h2>
                    @if (_isAdmin)
                    {
                        <label>Риелтор
                            <InputSelect @bind-Value="Model.AgentId">
                                <option value="">Выберите риелтора</option>
                                @foreach (var agent in AgentOptions)
                                {
                                    <option value="@agent.Key">@agent.Value</option>
                                }
                            </InputSelect>
                        </label>
                    }
                    <label>Тип недвижимости
                        <InputSelect @bind-Value="Model.TypeId">
                            <option value="">Выберите тип</option>
                            @foreach (var type in Types)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.TypeId)" />
                    </label>
                    <label>Статус
                        <InputSelect @bind-Value="Model.StatusId">
                            @foreach (var status in Statuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <div class="grid-2">
                        <label>Цена, ₽
                            <InputNumber @bind-Value="Model.Price" min="1" step="1" />
                            <ValidationMessage For="@(() => Model.Price)" />
                        </label>
                        <label>Площадь, м²
                            <InputNumber @bind-Value="Model.Area" min="1" step="0.01" />
                            <ValidationMessage For="@(() => Model.Area)" />
                        </label>
                    </div>
                    <div class="grid-2">
                        <label>Комнат
                            <InputNumber @bind-Value="Model.Rooms" min="1" step="1" />
                            <ValidationMessage For="@(() => Model.Rooms)" />
                        </label>
                        <label>Этаж
                            <InputNumber @bind-Value="Model.Floor" min="1" step="1" />
                            <ValidationMessage For="@(() => Model.Floor)" />
                        </label>
                    </div>
                    <label>Описание
                        <InputTextArea @bind-Value="Model.Description" rows="4" />
                        <ValidationMessage For="@(() => Model.Description)" />
                    </label>
                    <div class="form-stack">
                        <label>Новые фотографии
                            <InputFile OnChange="OnFilesSelected" multiple accept="image/jpeg,image/png,image/gif" />
                        </label>
                        @if (newPhotos.Count > 0)
                        {
                            <ul class="photo-file-list">
                                @for (var index = 0; index < newPhotos.Count; index++)
                                {
                                    var photo = newPhotos[index];
                                    var indexCopy = index;
                                    <li>
                                        <span>@photo.Name (@(Math.Round(photo.Size / 1024m, 1)) КБ)</span>
                                        <button type="button" class="ghost danger compact-button" @onclick="() => RemoveNewPhoto(indexCopy)">Удалить</button>
                                    </li>
                                }
                            </ul>
                        }
                        <p class="small-text">Поддерживаются JPG, PNG, GIF до 5 МБ за файл.</p>
                    </div>
                </div>
            </div>
            <div class="actions-row">
                <button type="submit" class="primary" disabled="@IsSaving">Сохранить изменения</button>
            </div>
        </EditForm>
    </div>

    <div class="panel" style="margin-top: 1rem;">
        <div class="section-header">
            <h2>Текущие фото</h2>
            <span class="small-text">@Photos.Count снимков</span>
        </div>
        @if (Photos.Count == 0)
        {
            <p class="small-text">Фотографии пока не загружены.</p>
        }
        else
        {
            <div class="photo-grid">
                @for (var index = 0; index < VisiblePhotos.Count; index++)
                {
                    var photo = VisiblePhotos[index];
                    var photoIndex = Photos.IndexOf(photo);
                    <div class="photo-editor-item">
                        <button type="button" class="photo-thumb" @onclick="() => OpenGallery(photoIndex)">
                            <img src="@photo.FilePath" alt="Фото объекта" />
                        </button>
                        <button type="button" class="ghost danger compact-button" @onclick="() => DeletePhotoAsync(photo.Id)" disabled="@IsSaving">Удалить</button>
                    </div>
                }
            </div>
            @if (Photos.Count > MaxVisiblePhotos)
            {
                <button type="button" class="ghost" @onclick="TogglePhotosExpanded">
                    @(showAllPhotos ? "Свернуть фото" : $"Показать все фото ({Photos.Count})")
                </button>
            }
        }
    </div>

    @if (isGalleryOpen && Photos.Count > 0)
    {
        var openPhoto = Photos[activePhotoIndex];
        <div class="photo-modal" role="dialog" aria-label="Просмотр фотографии">
            <div class="photo-modal__backdrop" @onclick="CloseGallery"></div>
            <div class="photo-modal__content">
                <button type="button" class="photo-modal__close" @onclick="CloseGallery" aria-label="Закрыть">×</button>
                <img src="@openPhoto.FilePath" alt="Фото объекта" />
                @if (Photos.Count > 1)
                {
                    <button type="button" class="photo-modal__nav prev" @onclick="PreviousPhoto" aria-label="Предыдущее фото">‹</button>
                    <button type="button" class="photo-modal__nav next" @onclick="NextPhoto" aria-label="Следующее фото">›</button>
                }
            </div>
        </div>
    }
}
else
{
    <p>Недостаточно прав для редактирования этого объекта.</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly List<District> Districts = new();
    private readonly List<Street> Streets = new();
    private readonly List<RealEstateType> Types = new();
    private readonly List<RealEstateStatus> Statuses = new();
    private readonly List<RealEstatePhoto> Photos = new();
    private RealEstateUpdateModel Model { get; set; } = new();
    private List<IBrowserFile> newPhotos = new();
    private int _userId;
    private bool _isAdmin;
    private bool IsLoading;
    private bool IsSaving;
    private bool IsGeocoding;
    private bool canEdit;
    private string? Notification;
    private string NotificationStyle = "info";
    private bool IsStreetSaving;
    private Dictionary<int, string> AgentOptions { get; set; } = new();
    private bool isGalleryOpen;
    private int activePhotoIndex;
    private bool showAllPhotos;
    private bool confirmDeleteObject;
    private string DistrictQuery = string.Empty;
    private string StreetQuery = string.Empty;
    private string AddressQuery = string.Empty;
    private IReadOnlyList<AddressSuggestion> AddressSuggestions = Array.Empty<AddressSuggestion>();
    private const int MaxVisiblePhotos = 3;
    private IReadOnlyList<RealEstatePhoto> VisiblePhotos => showAllPhotos
        ? Photos
        : Photos.Take(MaxVisiblePhotos).ToList();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            IsLoading = true;
            Notification = null;
            canEdit = false;

            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            var idValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            _userId = int.TryParse(idValue, out var parsed) ? parsed : 0;
            _isAdmin = user.IsInRole("admin");

            var item = await RealEstateService.GetDetailsAsync(Id, includeUnavailable: true);
            if (item is null)
            {
                Notification = "Объект не найден";
                NotificationStyle = "error";
                return;
            }

            if (!_isAdmin && await RealEstateService.IsUnavailableAsync(item.Id))
            {
                Notification = "Объект продан. Риелтор не может редактировать завершённую сделку.";
                NotificationStyle = "error";
                return;
            }

            if (!_isAdmin && item.AgentId != _userId)
            {
                Notification = "У вас нет прав для редактирования этого объекта";
                NotificationStyle = "error";
                return;
            }

            canEdit = true;

            if (Districts.Count == 0)
            {
                var districts = await RealEstateService.GetDistrictsAsync();
                var streets = await RealEstateService.GetStreetsAsync();
                var types = await RealEstateService.GetTypesAsync();
                var statuses = await LookupService.GetRealEstateStatusesAsync();

                Districts.AddRange(districts);
                Streets.AddRange(streets);
                Types.AddRange(types);
                Statuses.AddRange(_isAdmin ? statuses : statuses.Where(s => s.Code != "sold"));
            }
            if (_isAdmin && AgentOptions.Count == 0)
            {
                AgentOptions = await LookupService.GetAgentsAsync();
            }

            Model = new RealEstateUpdateModel
            {
                Id = item.Id,
                DistrictId = item.House?.DistrictId,
                StreetId = item.House?.StreetId,
                HouseNumber = item.House?.Number ?? string.Empty,
                TotalFloors = item.House?.TotalFloors ?? 1,
                HasParking = item.House?.HasParking ?? false,
                HasElevator = item.House?.HasElevator ?? false,
                BuildingYear = item.House?.BuildingYear,
                Latitude = item.House?.Latitude,
                Longitude = item.House?.Longitude,
                TypeId = item.TypeId,
                StatusId = item.StatusId,
                Price = item.Price,
                Rooms = item.Rooms,
                Area = item.Area,
                Floor = item.Floor,
                HasBalcony = item.HasBalcony,
                Description = item.Description
                ,
                AgentId = item.AgentId
            };

            Photos.Clear();
            Photos.AddRange(item.Photos?.Where(p => p.DeletedAt == null) ?? Enumerable.Empty<RealEstatePhoto>());
            DistrictQuery = item.House?.District?.Name ?? string.Empty;
            StreetQuery = item.House?.Street?.Name ?? string.Empty;
            AddressQuery = string.Join(", ", new[] { DistrictQuery, StreetQuery, item.House?.Number }
                .Where(part => !string.IsNullOrWhiteSpace(part)));
            isGalleryOpen = false;
            activePhotoIndex = 0;
            showAllPhotos = Photos.Count <= MaxVisiblePhotos;
            confirmDeleteObject = false;
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task UpdateAsync()
    {
        if (IsSaving)
        {
            return;
        }

        try
        {
            IsSaving = true;
            Notification = null;

            await RealEstateService.UpdateAsync(Model, _userId, _isAdmin);

            if (newPhotos.Count > 0)
            {
                var saved = await RealEstateService.SavePhotosAsync(Model.Id, newPhotos, _userId, _isAdmin);
                Photos.AddRange(saved);
                newPhotos.Clear();
            }

            Notification = "Изменения сохранены";
            NotificationStyle = "success";
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task AddStreetAsync()
    {
        if (IsStreetSaving)
        {
            return;
        }

        try
        {
            Notification = null;
            NotificationStyle = "info";

            if (!Model.DistrictId.HasValue)
            {
                Notification = "Сначала выберите район";
                NotificationStyle = "error";
                return;
            }

            IsStreetSaving = true;
            var street = await RealEstateService.CreateStreetAsync(Model.NewStreetName ?? string.Empty);

            if (!Streets.Any(s => s.Id == street.Id))
            {
                Streets.Add(street);
                Streets.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.Ordinal));
            }

            Model.StreetId = street.Id;
            Model.NewStreetName = string.Empty;
            Notification = $"Улица «{street.Name}» добавлена";
            NotificationStyle = "success";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsStreetSaving = false;
        }
    }

    private void OnDistrictInput(ChangeEventArgs args)
    {
        DistrictQuery = args.Value?.ToString() ?? string.Empty;
        var district = Districts.FirstOrDefault(d => string.Equals(d.Name, DistrictQuery, StringComparison.OrdinalIgnoreCase));
        Model.DistrictId = district?.Id;
    }

    private void OnStreetInput(ChangeEventArgs args)
    {
        StreetQuery = args.Value?.ToString() ?? string.Empty;
        var street = Streets.FirstOrDefault(s => string.Equals(s.Name, StreetQuery, StringComparison.OrdinalIgnoreCase));
        Model.StreetId = street?.Id;
        Model.NewStreetName = Model.StreetId.HasValue ? null : StreetQuery.Trim();
    }

    private async Task OnAddressInputAsync(ChangeEventArgs args)
    {
        AddressQuery = args.Value?.ToString() ?? string.Empty;
        AddressSuggestions = await AddressSuggestionService.SearchHousesAsync(AddressQuery);

        var selected = AddressSuggestions.FirstOrDefault(s => string.Equals(s.DisplayName, AddressQuery, StringComparison.OrdinalIgnoreCase));
        if (selected is not null)
        {
            ApplyAddressSuggestion(selected);
            return;
        }

        ApplyAddressQueryParts(AddressQuery);
    }

    private void ApplyAddressSuggestion(AddressSuggestion suggestion)
    {
        Model.DistrictId = suggestion.DistrictId;
        Model.StreetId = suggestion.StreetId;
        Model.NewStreetName = null;
        Model.HouseNumber = suggestion.HouseNumber;
        Model.TotalFloors = suggestion.TotalFloors;
        Model.HasParking = suggestion.HasParking;
        Model.HasElevator = suggestion.HasElevator;
        Model.BuildingYear = suggestion.BuildingYear;
        Model.Latitude = suggestion.Latitude;
        Model.Longitude = suggestion.Longitude;
        DistrictQuery = suggestion.DistrictName;
        StreetQuery = suggestion.StreetName;
        AddressQuery = suggestion.DisplayName;
    }

    private void ApplyAddressQueryParts(string query)
    {
        var parts = query
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        if (parts.Count >= 1)
        {
            var district = Districts.FirstOrDefault(d => parts.Any(part => string.Equals(NormalizeAddressPart(part), NormalizeAddressPart(d.Name), StringComparison.OrdinalIgnoreCase)));
            if (district is not null)
            {
                DistrictQuery = district.Name;
                Model.DistrictId = district.Id;
            }
        }

        if (parts.Count >= 1)
        {
            var street = Streets.FirstOrDefault(s => parts.Any(part => NormalizeAddressPart(part).Contains(NormalizeAddressPart(s.Name), StringComparison.OrdinalIgnoreCase)));
            if (street is not null)
            {
                StreetQuery = street.Name;
                Model.StreetId = street.Id;
                Model.NewStreetName = null;
            }
            else if (parts.Count >= 2)
            {
                StreetQuery = RemoveHouseNumber(NormalizeStreetInput(parts[^1]));
                Model.StreetId = null;
                Model.NewStreetName = StreetQuery;
            }
        }

        var houseNumber = ExtractHouseNumber(parts.LastOrDefault() ?? query);
        if (!string.IsNullOrWhiteSpace(houseNumber))
        {
            Model.HouseNumber = houseNumber;
        }
    }

    private static string NormalizeStreetInput(string value)
    {
        return global::System.Text.RegularExpressions.Regex
            .Replace(value, @"\b(ул\.?|улица|д\.?|дом)\b", string.Empty, global::System.Text.RegularExpressions.RegexOptions.IgnoreCase)
            .Trim(' ', ',', '.');
    }

    private static string NormalizeAddressPart(string value)
    {
        var normalized = NormalizeStreetInput(value).ToLowerInvariant().Replace('ё', 'е');
        normalized = global::System.Text.RegularExpressions.Regex.Replace(normalized, @"[.,;:()\[\]""'`]+", " ");
        normalized = global::System.Text.RegularExpressions.Regex.Replace(normalized, @"[-/\\]+", " ");
        normalized = global::System.Text.RegularExpressions.Regex.Replace(normalized, @"\s+", " ");
        return normalized.Trim();
    }

    private static string ExtractHouseNumber(string value)
    {
        var match = global::System.Text.RegularExpressions.Regex.Match(value, @"(?:\bд\.?\s*)?(\d+[а-яa-z0-9/-]*)\s*$", global::System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success ? match.Groups[1].Value.Trim() : string.Empty;
    }

    private static string RemoveHouseNumber(string value)
    {
        return global::System.Text.RegularExpressions.Regex.Replace(value, @"(?:\bд\.?\s*)?\d+[а-яa-z0-9/-]*\s*$", string.Empty, global::System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim(' ', ',', '.');
    }

    private async Task FindCoordinatesAsync()
    {
        if (IsGeocoding)
        {
            return;
        }

        try
        {
            IsGeocoding = true;
            Notification = null;
            NotificationStyle = "info";

            var address = BuildAddressForGeocoding();
            var coordinates = await GeocodingService.FindAsync(address);

            if (coordinates is null)
            {
                Notification = "Не удалось найти координаты по этому адресу. Проверьте район, улицу и номер дома.";
                NotificationStyle = "error";
                return;
            }

            Model.Latitude = coordinates.Value.Latitude;
            Model.Longitude = coordinates.Value.Longitude;
            Notification = "Координаты найдены и подставлены в форму.";
            NotificationStyle = "success";
        }
        catch (Exception ex)
        {
            Notification = ex is InvalidOperationException ? ex.Message : DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsGeocoding = false;
        }
    }

    private string BuildAddressForGeocoding()
    {
        var district = Districts.FirstOrDefault(d => d.Id == Model.DistrictId)?.Name;
        var street = Model.StreetId.HasValue
            ? Streets.FirstOrDefault(s => s.Id == Model.StreetId)?.Name
            : Model.NewStreetName;

        return string.Join(", ", new[] { district, street, Model.HouseNumber }
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .Select(part => part!.Trim()));
    }

    private Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.FileCount == 0)
            {
                newPhotos.Clear();
                Notification = null;
                NotificationStyle = "info";
                return Task.CompletedTask;
            }

            var files = e.GetMultipleFiles(e.FileCount);
            newPhotos = files.ToList();

            if (newPhotos.Count == 0)
            {
                Notification = null;
                NotificationStyle = "info";
                return Task.CompletedTask;
            }

            Notification = null;
            NotificationStyle = "info";
        }
        catch (Exception ex)
        {
            newPhotos = new List<IBrowserFile>();
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }

        return Task.CompletedTask;
    }

    private void RemoveNewPhoto(int index)
    {
        if (index < 0 || index >= newPhotos.Count)
        {
            return;
        }

        newPhotos.RemoveAt(index);
    }

    private async Task DeletePhotoAsync(int photoId)
    {
        if (IsSaving)
        {
            return;
        }

        try
        {
            IsSaving = true;
            await RealEstateService.DeletePhotoAsync(photoId, _userId, _isAdmin);
            Photos.RemoveAll(p => p.Id == photoId);
            isGalleryOpen = false;
            activePhotoIndex = 0;
            showAllPhotos = Photos.Count <= MaxVisiblePhotos || showAllPhotos;
            Notification = "Фото удалено";
            NotificationStyle = "success";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void TogglePhotosExpanded()
    {
        showAllPhotos = !showAllPhotos;
    }

    private void RequestObjectDelete()
    {
        confirmDeleteObject = true;
        Notification = "Нажмите «Подтвердить удаление», чтобы удалить объект.";
        NotificationStyle = "info";
    }

    private void CancelObjectDelete()
    {
        confirmDeleteObject = false;
        Notification = null;
        NotificationStyle = "info";
    }

    private async Task DeleteObjectAsync()
    {
        if (IsSaving)
        {
            return;
        }

        try
        {
            IsSaving = true;
            await RealEstateService.DeleteAsync(Model.Id, _userId, _isAdmin);
            NavigationManager.NavigateTo(_isAdmin ? "/admin" : "/realtor");
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo(IsSafeLocalReturnUrl(ReturnUrl) ? ReturnUrl! : $"/real-estate/{Id}");
    }

    private static bool IsSafeLocalReturnUrl(string? url)
    {
        return !string.IsNullOrWhiteSpace(url)
            && url.StartsWith("/", StringComparison.Ordinal)
            && !url.StartsWith("//", StringComparison.Ordinal)
            && !url.Contains("://", StringComparison.Ordinal);
    }

    private void OpenGallery(int index)
    {
        activePhotoIndex = Math.Clamp(index, 0, Math.Max(Photos.Count - 1, 0));
        isGalleryOpen = Photos.Count > 0;
    }

    private void CloseGallery() => isGalleryOpen = false;

    private void NextPhoto()
    {
        if (!isGalleryOpen || Photos.Count == 0) return;
        activePhotoIndex = (activePhotoIndex + 1) % Photos.Count;
    }

    private void PreviousPhoto()
    {
        if (!isGalleryOpen || Photos.Count == 0) return;
        activePhotoIndex = (activePhotoIndex - 1 + Photos.Count) % Photos.Count;
    }
}

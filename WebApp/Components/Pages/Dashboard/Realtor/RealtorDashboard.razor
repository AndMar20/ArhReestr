@page "/realtor"
@using DataLayer.Models
@using global::System.Security.Claims
@attribute [Authorize(Policy = "RequireAgent")]
@inject InteractionService InteractionService
@inject RealEstateService RealEstateService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Кабинет риелтора</PageTitle>

<section class="hero-card">
    <div class="section-header">
        <div>
            <h1 class="section-title">Панель риелтора</h1>
            <p class="section-sub">Управляйте заявками клиентов и отслеживайте ход встреч.</p>
        </div>
        @if (ActiveTab == "objects")
        {
            <div class="hero-actions">
                <NavLink class="primary" href="/realtor/create">Добавить объект</NavLink>
            </div>
        }
    </div>
    <RealtorNav ActiveTab="@ActiveTab" OnTabChanged="SetTab" />
    @if (ActiveTab == "overview")
    {
        <div class="stat-grid">
            <div class="stat-card">
                <h3>Всего обращений</h3>
                <div class="number">@Interactions.Count</div>
            </div>
            <div class="stat-card">
                <h3>Новые заявки</h3>
                <div class="number">@NewRequests</div>
            </div>
            <div class="stat-card">
                <h3>В работе</h3>
                <div class="number">@InProgress</div>
            </div>
            <div class="stat-card">
                <h3>Завершено</h3>
                <div class="number">@Closed</div>
            </div>
        </div>
    }
</section>

@if (!string.IsNullOrEmpty(Notification))
{
    <div class="alert @NotificationStyle">@Notification</div>
}

<div class="panel-stack">
    @if (ActiveTab == "requests")
    {
    <div class="panel">
        <div class="section-header">
            <div>
                <h2>Все заявки</h2>
                <p class="small-text">@FilteredInteractions.Count из @Interactions.Count записей</p>
            </div>
        </div>

        <div class="admin-filter-bar">
            <label>Поиск
                <input @bind="InteractionSearch" @bind:event="oninput" placeholder="Клиент, телефон, объект" />
            </label>
            <label>Статус
                <select @bind="InteractionStatusFilter">
                    <option value="">Все статусы</option>
                    @foreach (var status in Statuses)
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
                </select>
            </label>
            <button type="button" class="ghost filter-reset-button" @onclick="ResetInteractionFilters">Сбросить</button>
        </div>

        @if (FilteredInteractions.Count == 0)
        {
            <p class="muted">Подходящих заявок нет.</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table stacked-table">
                    <thead>
                        <tr>
                            <th>Клиент</th>
                            <th>Объект</th>
                            <th>Статус</th>
                            <th>Обновлено</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var interaction in FilteredInteractions)
                        {
                            <tr class="@(SelectedInteraction?.Id == interaction.Id ? "selected" : string.Empty)">
                                <td data-label="Клиент">
                                    <div class="cell-primary">@interaction.Client</div>
                                    <div class="cell-note">@interaction.ClientPhone</div>
                                </td>
                                <td data-label="Объект">
                                    <a class="cell-primary" href='@BuildObjectUrl(interaction.RealEstateId, "requests")'>@interaction.RealEstate</a>
                                    <div class="cell-note">Связался: @DateTimeDisplay.Format(interaction.ContactedAt)</div>
                                </td>
                                <td data-label="Статус" class="status-cell">
                                    <span class="badge @GetStatusBadge(interaction.Status)">@interaction.Status</span>
                                </td>
                                <td data-label="Обновлено">@DateTimeDisplay.Format(interaction.UpdatedAt)</td>
                                <td class="actions-row table-actions" data-label="Действия">
                                    <button @onclick="() => SelectInteraction(interaction)">Изменить</button>
                                    <a class="ghost" href="@($"/chat?realEstateId={interaction.RealEstateId}&peerId={interaction.ClientId}")">Чат</a>
                                </td>
                            </tr>
                            @if (SelectedInteraction?.Id == interaction.Id)
                            {
                                <tr class="interaction-editor">
                                    <td colspan="5">
                                        <div class="panel-section">
                                            <p class="small-text">
                                                Клиент: <strong>@SelectedInteraction.Client</strong><br />
                                                Телефон: <strong>@SelectedInteraction.ClientPhone</strong>
                                            </p>
                                            <EditForm Model="UpdateModel" OnValidSubmit="UpdateAsync" class="form-stack" FormName="interactionUpdateForm">
                                                <h3>Обновить взаимодействие #@SelectedInteraction.Id</h3>
                                                <label>Статус
                                                    <InputSelect @bind-Value="UpdateModel.StatusId">
                                                        @foreach (var status in Statuses)
                                                        {
                                                            <option value="@status.Id">@status.Name</option>
                                                        }
                                                    </InputSelect>
                                                </label>
                                                <label>Комментарий
                                                    <InputTextArea @bind-Value="UpdateModel.Notes" rows="3" />
                                                </label>
                                                <button type="submit">Сохранить</button>
                                            </EditForm>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    }

    @if (ActiveTab == "objects")
    {
    <div class="panel">
        <div class="section-header">
            <div>
                <h2>Мои объекты недвижимости</h2>
                <p class="small-text">@FilteredProperties.Count из @MyProperties.Count объектов</p>
            </div>
        </div>

        <div class="admin-filter-bar">
            <label>Поиск
                <input @bind="PropertySearch" @bind:event="oninput" placeholder="Адрес, район, тип" />
            </label>
            <label>Статус
                <select @bind="PropertyStatusFilter">
                    <option value="">Все статусы</option>
                    @foreach (var status in PropertyStatuses)
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
                </select>
            </label>
            <button type="button" class="ghost filter-reset-button" @onclick="ResetPropertyFilters">Сбросить</button>
        </div>

        @if (FilteredProperties.Count == 0)
        {
            <p class="muted">Подходящих объектов нет.</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table stacked-table">
                    <thead>
                        <tr>
                            <th>Адрес</th>
                            <th>Район</th>
                            <th>Тип</th>
                            <th>Статус</th>
                            <th>Цена</th>
                            <th>Параметры</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var estate in FilteredProperties)
                        {
                            <tr>
                                <td data-label="Адрес">
                                    <div class="cell-primary">@estate.Address</div>
                                </td>
                                <td data-label="Район">@estate.District</td>
                                <td data-label="Тип">@estate.Type</td>
                                <td data-label="Статус">
                                    <span class="badge @(estate.IsSold ? "danger" : string.Empty)">@estate.Status</span>
                                </td>
                                <td data-label="Цена">@estate.Price.ToString("N0") ₽</td>
                                <td data-label="Параметры">@estate.Rooms комн. · @estate.Area.ToString("N2") м² · @estate.Floor/@estate.TotalFloors эт.</td>
                                <td class="actions-row table-actions" data-label="Действия">
                                    @if (estate.IsSold)
                                    {
                                        <span class="small-text">Редактирование закрыто</span>
                                    }
                                    else
                                    {
                                        <NavLink href='@BuildObjectUrl(estate.Id, "objects")' class="ghost">К объекту</NavLink>
                                        <NavLink href="@BuildEditUrl(estate.Id)" class="primary">Изменить</NavLink>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    }
</div>

@code {
    private readonly List<InteractionSummary> Interactions = new();
    private readonly List<DataLayer.Models.InteractionStatus> Statuses = new();
    private readonly InteractionUpdateRequest UpdateModel = new();
    private readonly List<RealEstateSummary> MyProperties = new();
    private readonly List<RealEstateStatus> PropertyStatuses = new();
    private InteractionSummary? SelectedInteraction;
    private string ActiveTab { get; set; } = "overview";
    private int _userId;
    private string? Notification;
    private string NotificationStyle { get; set; } = "info";
    private string InteractionSearch { get; set; } = string.Empty;
    private int? InteractionStatusFilter { get; set; }
    private string PropertySearch { get; set; } = string.Empty;
    private string PropertyStatusFilter { get; set; } = string.Empty;
    private int NewRequests => CountByKeyword("ожид" , "заявка", "нов");
    private int InProgress => CountByKeyword("работ", "встреч");
    private int Closed => CountByKeyword("закры", "заверш");
    private List<InteractionSummary> FilteredInteractions => Interactions
        .Where(i => InteractionStatusFilter is null || i.StatusId == InteractionStatusFilter)
        .Where(MatchesInteractionSearch)
        .ToList();
    private List<RealEstateSummary> FilteredProperties => MyProperties
        .Where(MatchesPropertySearch)
        .Where(MatchesPropertyStatus)
        .ToList();

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var idValue = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            _userId = int.TryParse(idValue, out var parsed) ? parsed : 0;

            if (_userId <= 0)
            {
                Notification = "Не удалось определить пользователя. Перезайдите в систему.";
                NotificationStyle = "error";
                return;
            }

            var statuses = await InteractionService.GetStatusesAsync();
            Statuses.AddRange(statuses);
            await LoadAsync();
            await LoadPropertiesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var data = await InteractionService.GetAgentInteractionsAsync(_userId);
            Interactions.Clear();
            Interactions.AddRange(data);
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
    }

    private async Task LoadPropertiesAsync()
    {
        if (_userId <= 0)
        {
            return;
        }

        try
        {
            var estates = await RealEstateService.GetByAgentAsync(_userId);
            MyProperties.Clear();
            MyProperties.AddRange(estates);
            PropertyStatuses.Clear();
            PropertyStatuses.AddRange(estates
                .Where(e => e.StatusId > 0 && !string.IsNullOrWhiteSpace(e.Status))
                .GroupBy(e => e.StatusId)
                .Select(g => new RealEstateStatus { Id = g.Key, Name = g.First().Status })
                .OrderBy(s => s.Id));
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
    }

    private int CountByKeyword(params string[] keywords)
    {
        return Interactions.Count(i => keywords.Any(k => i.Status.Contains(k, StringComparison.OrdinalIgnoreCase)));
    }

    protected override void OnParametersSet()
    {
        if (Tab is "overview" or "requests" or "objects")
        {
            ActiveTab = Tab;
        }
    }

    private bool MatchesInteractionSearch(InteractionSummary interaction)
    {
        if (string.IsNullOrWhiteSpace(InteractionSearch))
        {
            return true;
        }

        var term = InteractionSearch.Trim();
        return interaction.Client.Contains(term, StringComparison.OrdinalIgnoreCase)
            || interaction.ClientPhone.Contains(term, StringComparison.OrdinalIgnoreCase)
            || interaction.RealEstate.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesPropertySearch(RealEstateSummary estate)
    {
        if (string.IsNullOrWhiteSpace(PropertySearch))
        {
            return true;
        }

        var term = PropertySearch.Trim();
        return estate.Address.Contains(term, StringComparison.OrdinalIgnoreCase)
            || estate.District.Contains(term, StringComparison.OrdinalIgnoreCase)
            || estate.Type.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesPropertyStatus(RealEstateSummary estate)
    {
        return string.IsNullOrWhiteSpace(PropertyStatusFilter)
            || (int.TryParse(PropertyStatusFilter, out var statusId) && estate.StatusId == statusId);
    }

    private void ResetInteractionFilters()
    {
        InteractionSearch = string.Empty;
        InteractionStatusFilter = null;
    }

    private void ResetPropertyFilters()
    {
        PropertySearch = string.Empty;
        PropertyStatusFilter = string.Empty;
    }

    private static string GetStatusBadge(string status)
    {
        if (status.Contains("заверш", StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (status.Contains("работ", StringComparison.OrdinalIgnoreCase) || status.Contains("встреч", StringComparison.OrdinalIgnoreCase))
        {
            return "accent";
        }

        if (status.Contains("отказ", StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        return string.Empty;
    }

    private void SelectInteraction(InteractionSummary summary)
    {
        SelectedInteraction = summary;
        UpdateModel.InteractionId = summary.Id;
        UpdateModel.StatusId = summary.StatusId;
        UpdateModel.Notes = summary.Notes;
        Notification = null;
        NotificationStyle = "info";
    }

    private Task SetTab(string tab)
    {
        ActiveTab = tab;
        SelectedInteraction = null;
        Notification = null;
        return Task.CompletedTask;
    }

    private static string BuildObjectUrl(int id, string tab) => $"/real-estate/{id}?returnUrl={Uri.EscapeDataString($"/realtor?tab={tab}")}";

    private static string BuildEditUrl(int id) => $"/real-estate/{id}/edit?returnUrl={Uri.EscapeDataString("/realtor?tab=objects")}";

    private async Task UpdateAsync()
    {
        try
        {
            await InteractionService.UpdateStatusAsync(UpdateModel, _userId, false);
            Notification = "Статус обновлён";
            NotificationStyle = "success";
            await LoadAsync();
            SelectedInteraction = null;
        }
        catch (Exception ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
    }
}

@page "/admin/users"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject AdminUserService AdminUserService
@inject LookupService LookupService
@inject ILogger<ManageUsers> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@using DataLayer.Models
@using global::System.Security.Claims

<PageTitle>Пользователи</PageTitle>

@if (IsLoading)
{
    <div class="alert info">Загружаем список пользователей...</div>
}
else
{
    <section class="hero-card admin-hero">
        <div class="section-header">
            <div>
                <h1 class="section-title">Пользователи</h1>
                <p class="section-sub">Поиск, роли и создание аккаунтов из панели администратора.</p>
            </div>
            <button type="button" class="primary" @onclick="ToggleCreateForm">
                @(ShowCreateForm ? "Закрыть форму" : "Добавить пользователя")
            </button>
        </div>
        <AdminNav />
    </section>

    @if (!string.IsNullOrEmpty(Notification))
    {
        <div class="alert @NotificationStyle">@Notification</div>
    }

    @if (ShowCreateForm)
    {
        <div class="panel admin-create-panel">
            <div class="section-header">
                <div>
                    <h2>Новый пользователь</h2>
                    <p class="small-text">Форма скрыта по умолчанию, чтобы список оставался рабочим.</p>
                </div>
            </div>
            <EditForm EditContext="newUserContext" OnValidSubmit="CreateUserAsync" class="form-stack">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="grid-three">
                    <label>Фамилия
                        <InputText @bind-Value="NewUser.LastName" />
                        <ValidationMessage For="@(() => NewUser.LastName)" />
                    </label>
                    <label>Имя
                        <InputText @bind-Value="NewUser.FirstName" />
                        <ValidationMessage For="@(() => NewUser.FirstName)" />
                    </label>
                    <label>Отчество
                        <InputText @bind-Value="NewUser.MiddleName" />
                        <ValidationMessage For="@(() => NewUser.MiddleName)" />
                    </label>
                </div>
                <div class="grid-three">
                    <label>Email
                        <InputText @bind-Value="NewUser.Email" type="email" />
                        <ValidationMessage For="@(() => NewUser.Email)" />
                    </label>
                    <label>Телефон
                        <InputText @bind-Value="NewUser.Phone" type="tel" />
                        <ValidationMessage For="@(() => NewUser.Phone)" />
                    </label>
                    <label>Пароль
                        <InputText @bind-Value="NewUser.Password" type="password" />
                        <ValidationMessage For="@(() => NewUser.Password)" />
                    </label>
                </div>
                <div class="grid-two">
                    <label>Роль
                        <InputSelect @bind-Value="NewUser.RoleName">
                            @foreach (var role in Roles)
                            {
                                <option value="@role.Name">@role.DisplayName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => NewUser.RoleName)" />
                    </label>
                </div>
                <div class="buttons">
                    <button type="submit" class="primary" disabled="@isCreatingUser">@(isCreatingUser ? "Создаем..." : "Добавить пользователя")</button>
                    <button type="button" class="ghost" @onclick="ToggleCreateForm">Отмена</button>
                </div>
            </EditForm>
        </div>
    }

    <div class="panel">
        <div class="section-header">
            <div>
                <h2>Все пользователи</h2>
                <p class="small-text">@FilteredUsers.Count из @Users.Count записей</p>
            </div>
        </div>

        <div class="admin-filter-bar">
            <label>Поиск
                <input @bind="UserSearch" @bind:event="oninput" placeholder="ФИО, email, телефон" />
            </label>
            <label>Роль
                <select @bind="RoleFilter">
                    <option value="">Все роли</option>
                    @foreach (var role in Roles)
                    {
                        <option value="@role.Name">@role.DisplayName</option>
                    }
                </select>
            </label>
            <button type="button" class="ghost filter-reset-button" @onclick="ResetFilters">Сбросить</button>
        </div>

        @if (FilteredUsers.Count == 0)
        {
            <p class="muted">Пользователи не найдены.</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table stacked-table">
                    <thead>
                        <tr>
                            <th>ФИО</th>
                            <th>Контакты</th>
                            <th>Роль</th>
                            <th>Создан</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            var isBlocking = blockingUsers.Contains(user.Id);
                            <tr>
                                <td data-label="ФИО">
                                    <div class="cell-primary">@user.FullName</div>
                                    <div class="cell-note">ID: @user.Id</div>
                                    @if (user.IsBlocked)
                                    {
                                        <span class="badge role-badge danger">Заблокирован</span>
                                    }
                                </td>
                                <td data-label="Контакты">
                                    <div>@user.Email</div>
                                    <div class="cell-note">@user.Phone</div>
                                </td>
                                <td data-label="Роль">
                                    <span class="badge role-badge">@user.RoleDisplayName</span>
                                    <div class="select compact-select">
                                        <select @bind="user.SelectedRole" disabled="@(user.IsSaving || user.IsBlocked)" aria-label="Выбрать роль для пользователя @user.FullName">
                                            @foreach (var role in Roles)
                                            {
                                                <option value="@role.Name">@role.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                </td>
                                <td data-label="Создан">@DateTimeDisplay.Format(user.CreatedAt)</td>
                                <td class="table-actions user-management-actions" data-label="Действия">
                                    <input class="compact-password-input" type="password" placeholder="Новый пароль" @bind="user.NewPassword" disabled="@(user.IsSaving || user.IsBlocked)" />
                                    <button class="ghost" disabled="@(user.IsSaving || user.IsBlocked)" @onclick="() => ResetPasswordAsync(user)">
                                        @(user.IsSaving ? "Сохраняем..." : "Сменить пароль")
                                    </button>
                                    <button class="ghost" disabled="@(user.IsSaving || user.IsBlocked)" @onclick="() => SaveRoleAsync(user)">
                                        @(user.IsSaving ? "Сохраняем..." : "Обновить роль")
                                    </button>
                                    @if (user.IsBlocked)
                                    {
                                        <button class="ghost" disabled="@isBlocking" @onclick="() => UnblockUserAsync(user)">
                                            @(isBlocking ? "Разблокируем..." : "Разблокировать")
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="danger ghost" disabled="@(isBlocking || IsSameUser(user))" @onclick="() => BlockUserAsync(user)">
                                            @(isBlocking ? "Блокируем..." : "Заблокировать email")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<Role> Roles { get; set; } = new();
    private List<EditableUser> Users { get; set; } = new();
    private string? Notification;
    private string NotificationStyle { get; set; } = "info";
    private bool IsLoading { get; set; } = true;
    private readonly AdminUserCreateModel NewUser = new();
    private EditContext? newUserContext;
    private bool isCreatingUser;
    private bool ShowCreateForm;
    private string UserSearch { get; set; } = string.Empty;
    private string RoleFilter { get; set; } = string.Empty;
    private readonly HashSet<int> blockingUsers = new();
    private int currentUserId;

    private List<EditableUser> FilteredUsers => Users
        .Where(MatchesSearch)
        .Where(u => string.IsNullOrWhiteSpace(RoleFilter) || u.RoleName == RoleFilter)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        newUserContext = new EditContext(NewUser);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            Roles = (await LookupService.GetRolesAsync()).ToList();
            if (string.IsNullOrEmpty(NewUser.RoleName))
            {
                NewUser.RoleName = Roles.FirstOrDefault()?.Name ?? string.Empty;
            }

            Users = (await AdminUserService.GetUsersAsync()).Select(u => new EditableUser(u)).ToList();

            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var idValue = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idValue, out var parsedId))
            {
                currentUserId = parsedId;
            }
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
            Logger.LogError(ex, "Не удалось загрузить пользователей");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private bool MatchesSearch(EditableUser user)
    {
        if (string.IsNullOrWhiteSpace(UserSearch))
        {
            return true;
        }

        var term = UserSearch.Trim();
        return user.FullName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || user.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
            || user.Phone.Contains(term, StringComparison.OrdinalIgnoreCase)
            || user.RoleDisplayName.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private void ResetFilters()
    {
        UserSearch = string.Empty;
        RoleFilter = string.Empty;
    }

    private void ToggleCreateForm()
    {
        ShowCreateForm = !ShowCreateForm;
    }

    private async Task ReloadUsersAsync()
    {
        var loaded = await AdminUserService.GetUsersAsync();
        Users = loaded.Select(u => new EditableUser(u)).ToList();
    }

    private async Task SaveRoleAsync(EditableUser user)
    {
        Notification = null;
        NotificationStyle = "info";
        user.IsSaving = true;

        try
        {
            await AdminUserService.UpdateUserRoleAsync(user.Id, user.SelectedRole, currentUserId);
            await ReloadUsersAsync();
            Notification = $"Роль пользователя {user.FullName} обновлена.";
            NotificationStyle = "success";
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
            Logger.LogError(ex, "Ошибка при смене роли пользователя {UserId}", user.Id);
        }
        finally
        {
            user.IsSaving = false;
        }
    }

    private async Task ResetPasswordAsync(EditableUser user)
    {
        Notification = null;
        NotificationStyle = "info";
        user.IsSaving = true;

        try
        {
            await AdminUserService.ResetPasswordAsync(user.Id, user.NewPassword, currentUserId);
            user.NewPassword = string.Empty;
            Notification = $"Пароль пользователя {user.FullName} изменён.";
            NotificationStyle = "success";
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
            Logger.LogError(ex, "Ошибка при смене пароля пользователя {UserId}", user.Id);
        }
        finally
        {
            user.IsSaving = false;
        }
    }

    private async Task CreateUserAsync()
    {
        Notification = null;
        NotificationStyle = "info";

        if (newUserContext is not null && !newUserContext.Validate())
        {
            return;
        }

        isCreatingUser = true;

        try
        {
            var created = await AdminUserService.CreateUserAsync(NewUser);
            Users.Add(new EditableUser(created));
            Notification = "Пользователь успешно добавлен.";
            NotificationStyle = "success";
            ShowCreateForm = false;

            NewUser.LastName = string.Empty;
            NewUser.FirstName = string.Empty;
            NewUser.MiddleName = null;
            NewUser.Email = string.Empty;
            NewUser.Phone = null;
            NewUser.Password = string.Empty;
            NewUser.RoleName = Roles.FirstOrDefault()?.Name ?? string.Empty;
            newUserContext = new EditContext(NewUser);
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
            Logger.LogError(ex, "Ошибка при создании пользователя");
        }
        finally
        {
            isCreatingUser = false;
        }
    }

    private async Task BlockUserAsync(EditableUser user)
    {
        if (IsSameUser(user))
        {
            Notification = "Нельзя заблокировать собственную учётную запись.";
            NotificationStyle = "error";
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Заблокировать вход по email {user.Email}? Пользователь не сможет войти и отправлять сообщения.");
        if (!confirmed || !blockingUsers.Add(user.Id))
        {
            return;
        }

        try
        {
            await AdminUserService.BlockUserAsync(user.Id, currentUserId);
            await ReloadUsersAsync();
            Notification = $"Пользователь {user.FullName} заблокирован.";
            NotificationStyle = "success";
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
            Logger.LogError(ex, "Ошибка при блокировке пользователя {UserId}", user.Id);
        }
        finally
        {
            blockingUsers.Remove(user.Id);
        }
    }

    private async Task UnblockUserAsync(EditableUser user)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Разблокировать вход по email {user.Email}?");
        if (!confirmed || !blockingUsers.Add(user.Id))
        {
            return;
        }

        try
        {
            await AdminUserService.UnblockUserAsync(user.Id, currentUserId);
            await ReloadUsersAsync();
            Notification = $"Пользователь {user.FullName} разблокирован.";
            NotificationStyle = "success";
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
            Logger.LogError(ex, "Ошибка при разблокировке пользователя {UserId}", user.Id);
        }
        finally
        {
            blockingUsers.Remove(user.Id);
        }
    }

    private bool IsSameUser(EditableUser user) => user.Id == currentUserId;

    private class EditableUser
    {
        public EditableUser(UserListItem item)
        {
            Id = item.Id;
            FullName = item.FullName;
            Email = item.Email;
            Phone = item.Phone;
            RoleName = item.RoleName;
            RoleDisplayName = item.RoleDisplayName;
            CreatedAt = item.CreatedAt;
            DeletedAt = item.DeletedAt;
            SelectedRole = item.RoleName;
        }

        public int Id { get; }
        public string FullName { get; }
        public string Email { get; }
        public string Phone { get; }
        public string RoleName { get; set; }
        public string RoleDisplayName { get; set; }
        public string SelectedRole { get; set; }
        public DateTime CreatedAt { get; }
        public DateTime? DeletedAt { get; }
        public bool IsBlocked => DeletedAt.HasValue;
        public string NewPassword { get; set; } = string.Empty;
        public bool IsSaving { get; set; }
    }
}

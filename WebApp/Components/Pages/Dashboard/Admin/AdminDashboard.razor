@page "/admin"
@using WebApp.ViewModels
@attribute [Authorize(Policy = "RequireAdmin")]
@inject ReportService ReportService

<PageTitle>Кабинет администратора</PageTitle>

@if (IsLoading)
{
    <div class="alert info">Подключаемся к базе данных и загружаем статистику...</div>
}
else
{
    <section class="hero-card admin-hero">
        <div class="section-header">
            <div>
                <h1 class="section-title">Панель администратора</h1>
                <p class="section-sub">Контроль объектов, пользователей и ключевых показателей системы.</p>
            </div>
        </div>
        <AdminNav />
    </section>

    @if (!string.IsNullOrEmpty(Notification))
    {
        <div class="alert @NotificationStyle">@Notification</div>
    }

    <div class="stat-grid admin-stat-grid">
        <div class="stat-card">
            <h3>Всего объектов</h3>
            <div class="number">@Stats.TotalObjects</div>
        </div>
        <div class="stat-card">
            <h3>Активных объектов</h3>
            <div class="number">@Stats.ActiveObjects</div>
        </div>
        <div class="stat-card">
            <h3>Пользователей</h3>
            <div class="number">@Stats.TotalUsers</div>
        </div>
        <div class="stat-card">
            <h3>Риелторов</h3>
            <div class="number">@Stats.Agents</div>
        </div>
        <div class="stat-card">
            <h3>Клиентов</h3>
            <div class="number">@Stats.Clients</div>
        </div>
        <div class="stat-card">
            <h3>Завершённых сделок</h3>
            <div class="number">@Stats.ClosedDeals</div>
        </div>
    </div>

    <div class="grid">
        <article>
            <div class="section-header">
                <h2>Популярные районы</h2>
                <span class="small-text">Объектов</span>
            </div>
            <ol class="report-list">
                @foreach (var item in Districts)
                {
                    <li><span>@item.Category</span><strong>@item.Value</strong></li>
                }
            </ol>
        </article>
        <article>
            <div class="section-header">
                <h2>Активность риелторов</h2>
                <span class="small-text">Заявок</span>
            </div>
            <ol class="report-list">
                @foreach (var item in Agents)
                {
                    <li><span>@item.Category</span><strong>@item.Value</strong></li>
                }
            </ol>
        </article>
        <article>
            <div class="section-header">
                <h2>Итоги взаимодействий</h2>
                <span class="small-text">По статусам</span>
            </div>
            <ol class="report-list">
                @foreach (var item in Statuses)
                {
                    <li><span>@item.Category</span><strong>@item.Value</strong></li>
                }
            </ol>
        </article>
    </div>
}

@code {
    private AdminDashboardStats Stats { get; set; } = new(0, 0, 0, 0, 0, 0, 0);
    private IReadOnlyList<AdminReportRow> Districts { get; set; } = Array.Empty<AdminReportRow>();
    private IReadOnlyList<AdminReportRow> Agents { get; set; } = Array.Empty<AdminReportRow>();
    private IReadOnlyList<AdminReportRow> Statuses { get; set; } = Array.Empty<AdminReportRow>();
    private string? Notification;
    private string NotificationStyle { get; set; } = "info";
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var report = await ReportService.BuildAsync();
            Stats = await ReportService.GetDashboardStatsAsync();
            Districts = report.Districts;
            Agents = report.Agents;
            Statuses = report.Statuses;
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

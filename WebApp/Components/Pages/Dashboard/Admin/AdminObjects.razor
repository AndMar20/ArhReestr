@page "/admin/objects"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject RealEstateService RealEstateService
@inject LookupService LookupService

<PageTitle>Объекты</PageTitle>

@if (IsLoading)
{
    <div class="alert info">Загружаем объекты недвижимости...</div>
}
else
{
    <section class="hero-card admin-hero">
        <div class="section-header">
            <div>
                <h1 class="section-title">Объекты</h1>
                <p class="section-sub">Проверяйте адреса, координаты, фото и карточки объявлений.</p>
            </div>
            <div class="hero-actions">
                <NavLink class="primary" href="/realtor/create">Добавить объект</NavLink>
            </div>
        </div>
        <AdminNav />
    </section>

    @if (!string.IsNullOrWhiteSpace(Notification))
    {
        <div class="alert @NotificationStyle">@Notification</div>
    }

    <div class="panel">
        <div class="section-header">
            <div>
                <h2>Все объекты</h2>
                <p class="small-text">@FilteredObjects.Count из @Objects.Count записей</p>
            </div>
        </div>

        <div class="admin-filter-bar">
            <label>Поиск
                <input @bind="SearchTerm" @bind:event="oninput" placeholder="Адрес, район, риелтор" />
            </label>
            <label>Статус
                <select @bind="StatusFilter">
                    <option value="">Все статусы</option>
                    @foreach (var status in Statuses)
                    {
                        <option value="@status.Id">@status.Name</option>
                    }
                </select>
            </label>
            <button type="button" class="ghost filter-reset-button" @onclick="ResetFilters">Сбросить</button>
        </div>

        @if (FilteredObjects.Count == 0)
        {
            <p class="muted">Подходящих объектов нет.</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table stacked-table">
                    <thead>
                        <tr>
                            <th>Объект</th>
                            <th>Риелтор</th>
                            <th>Параметры</th>
                            <th>Цена</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredObjects)
                        {
                            <tr>
                                <td data-label="Объект">
                                    <a class="cell-primary" href="@BuildObjectUrl(item.Id)">@item.Address</a>
                                    <div class="cell-note">@item.District · @item.Type</div>
                                    <span class="badge @(item.IsSold ? "danger" : string.Empty)">@item.Status</span>
                                </td>
                                <td data-label="Риелтор">@item.Agent</td>
                                <td data-label="Параметры">@item.Rooms комн. · @item.Area м² · @item.Floor/@item.TotalFloors эт.</td>
                                <td data-label="Цена">@item.Price.ToString("N0") ₽</td>
                                <td class="table-actions" data-label="Действия">
                                    <a class="ghost" href="@BuildObjectUrl(item.Id)">К объекту</a>
                                    <a class="primary" href="@BuildEditUrl(item.Id)">Изменить</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<RealEstateSummary> Objects { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? Notification;
    private string NotificationStyle { get; set; } = "info";
    private string SearchTerm { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = string.Empty;
    private List<DataLayer.Models.RealEstateStatus> Statuses { get; set; } = new();

    private List<RealEstateSummary> FilteredObjects => Objects
        .Where(MatchesSearch)
        .Where(MatchesStatusFilter)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Statuses = (await LookupService.GetRealEstateStatusesAsync()).ToList();
            var result = await RealEstateService.SearchAsync(new RealEstateFilterModel
            {
                Page = 1,
                PageSize = 200,
                SortBy = "created",
                SortDescending = true,
                IncludeUnavailable = true
            });

            Objects = result.Items.ToList();
        }
        catch (InvalidOperationException ex)
        {
            Notification = ex.Message;
            NotificationStyle = "error";
        }
        catch (Exception ex)
        {
            Notification = DatabaseErrorMessages.Resolve(ex);
            NotificationStyle = "error";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private bool MatchesSearch(RealEstateSummary item)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            return true;
        }

        var term = SearchTerm.Trim();
        return item.Address.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.District.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Agent.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Type.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesStatusFilter(RealEstateSummary item)
    {
        if (string.IsNullOrWhiteSpace(StatusFilter))
        {
            return true;
        }

        return int.TryParse(StatusFilter, out var statusId) && item.StatusId == statusId;
    }

    private void ResetFilters()
    {
        SearchTerm = string.Empty;
        StatusFilter = string.Empty;
    }

    private static string BuildObjectUrl(int id) => $"/real-estate/{id}?returnUrl={Uri.EscapeDataString("/admin/objects")}";

    private static string BuildEditUrl(int id) => $"/real-estate/{id}/edit?returnUrl={Uri.EscapeDataString("/admin/objects")}";

}

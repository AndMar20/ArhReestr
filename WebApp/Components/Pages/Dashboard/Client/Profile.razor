@page "/profile"
@attribute [Authorize]
@using global::System.ComponentModel.DataAnnotations
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Мой профиль</PageTitle>

<section class="hero-card narrow profile-card">
    <div class="section-header">
        <h1 class="section-title">Мои данные</h1>
    </div>

    @if (!string.IsNullOrWhiteSpace(Notification))
    {
        <div class="alert @NotificationStyle">@Notification</div>
    }

    <EditForm Model="Model" OnValidSubmit="SaveAsync" class="form-stack" FormName="profileForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>Фамилия
            <InputText @bind-Value="Model.LastName" />
        </label>
        <label>Имя
            <InputText @bind-Value="Model.FirstName" />
        </label>
        <label>Отчество (необязательно)
            <InputText @bind-Value="Model.MiddleName" />
        </label>
        <label>Телефон
            <InputText @bind-Value="Model.PhoneNumber" type="tel" />
        </label>
        <label>Email
            <InputText @bind-Value="Model.Email" type="email" disabled />
        </label>

        <button type="submit" class="primary" disabled="@IsSaving">@(IsSaving ? "Сохранение..." : "Сохранить")</button>
    </EditForm>

    <div class="panel-section password-section">
        <div class="section-header compact">
            <div>
                <h2>Пароль</h2>
                <p class="small-text">Сначала подтвердите текущий пароль, затем задайте новый.</p>
            </div>
            @if (!IsPasswordFlowVisible)
            {
                <button type="button" class="ghost" @onclick="StartPasswordFlow">Изменить пароль</button>
            }
        </div>

        @if (IsPasswordFlowVisible && !IsCurrentPasswordVerified)
        {
            <EditForm Model="VerifyPassword" OnValidSubmit="VerifyCurrentPasswordAsync" class="form-stack password-flow-form" FormName="verifyPasswordForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label>Текущий пароль
                    <InputText @bind-Value="VerifyPassword.CurrentPassword" type="password" autocomplete="current-password" />
                </label>

                <div class="actions-row password-actions">
                    <button type="submit" class="primary" disabled="@IsChangingPassword">
                        @(IsChangingPassword ? "Проверка..." : "Подтвердить пароль")
                    </button>
                    <button type="button" class="ghost" @onclick="CancelPasswordFlow" disabled="@IsChangingPassword">Отмена</button>
                </div>
            </EditForm>
        }
        else if (IsPasswordFlowVisible)
        {
            <EditForm Model="NewPassword" OnValidSubmit="ChangePasswordAsync" class="form-stack password-flow-form" FormName="changePasswordForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label>Новый пароль
                    <InputText @bind-Value="NewPassword.NewPassword" type="password" autocomplete="new-password" />
                </label>
                <label>Повторите новый пароль
                    <InputText @bind-Value="NewPassword.ConfirmPassword" type="password" autocomplete="new-password" />
                </label>

                <div class="actions-row password-actions">
                    <button type="submit" class="primary" disabled="@IsChangingPassword">
                        @(IsChangingPassword ? "Обновление..." : "Сохранить новый пароль")
                    </button>
                    <button type="button" class="ghost" @onclick="CancelPasswordFlow" disabled="@IsChangingPassword">Отмена</button>
                </div>
            </EditForm>
        }
    </div>
</section>

@code {
    private readonly ApplicationUser Model = new();
    private readonly VerifyPasswordModel VerifyPassword = new();
    private readonly NewPasswordModel NewPassword = new();
    private string verifiedCurrentPassword = string.Empty;
    private string? Notification;
    private string NotificationStyle = "info";
    private bool IsSaving;
    private bool IsChangingPassword;
    private bool IsPasswordFlowVisible;
    private bool IsCurrentPasswordVerified;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            Notification = "Не удалось загрузить профиль.";
            NotificationStyle = "error";
            return;
        }

        Model.Id = user.Id;
        Model.LastName = user.LastName;
        Model.FirstName = user.FirstName;
        Model.MiddleName = user.MiddleName;
        Model.PhoneNumber = user.PhoneNumber;
        Model.Email = user.Email;
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(state.User);
            if (user is null)
            {
                Notification = "Пользователь не найден.";
                NotificationStyle = "error";
                return;
            }

            user.LastName = Model.LastName.Trim();
            user.FirstName = Model.FirstName.Trim();
            user.MiddleName = string.IsNullOrWhiteSpace(Model.MiddleName) ? null : Model.MiddleName.Trim();
            user.PhoneNumber = Model.PhoneNumber?.Trim();

            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded)
            {
                Notification = string.Join("; ", result.Errors.Select(e => e.Description));
                NotificationStyle = "error";
                return;
            }

            Notification = "Данные успешно сохранены.";
            NotificationStyle = "success";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void StartPasswordFlow()
    {
        Notification = null;
        VerifyPassword.CurrentPassword = string.Empty;
        NewPassword.NewPassword = string.Empty;
        NewPassword.ConfirmPassword = string.Empty;
        IsPasswordFlowVisible = true;
        IsCurrentPasswordVerified = false;
    }

    private void CancelPasswordFlow()
    {
        VerifyPassword.CurrentPassword = string.Empty;
        NewPassword.NewPassword = string.Empty;
        NewPassword.ConfirmPassword = string.Empty;
        IsPasswordFlowVisible = false;
        IsCurrentPasswordVerified = false;
        IsChangingPassword = false;
    }

    private async Task VerifyCurrentPasswordAsync()
    {
        IsChangingPassword = true;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(state.User);
            if (user is null)
            {
                Notification = "Пользователь не найден.";
                NotificationStyle = "error";
                return;
            }

            if (!await UserManager.CheckPasswordAsync(user, VerifyPassword.CurrentPassword))
            {
                Notification = "Текущий пароль указан неверно.";
                NotificationStyle = "error";
                return;
            }

            verifiedCurrentPassword = VerifyPassword.CurrentPassword;
            NewPassword.NewPassword = string.Empty;
            NewPassword.ConfirmPassword = string.Empty;
            IsCurrentPasswordVerified = true;
            Notification = "Текущий пароль подтверждён. Введите новый пароль.";
            NotificationStyle = "success";
        }
        finally
        {
            IsChangingPassword = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (!IsCurrentPasswordVerified)
        {
            Notification = "Сначала подтвердите текущий пароль.";
            NotificationStyle = "error";
            return;
        }

        IsChangingPassword = true;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(state.User);
            if (user is null)
            {
                Notification = "Пользователь не найден.";
                NotificationStyle = "error";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, verifiedCurrentPassword, NewPassword.NewPassword);
            if (!result.Succeeded)
            {
                Notification = string.Join("; ", result.Errors.Select(e => e.Description));
                NotificationStyle = "error";
                return;
            }

            CancelPasswordFlow();
            Notification = "Пароль успешно изменён.";
            NotificationStyle = "success";
        }
        finally
        {
            IsChangingPassword = false;
        }
    }

    private sealed class VerifyPasswordModel
    {
        [Required(ErrorMessage = "Введите текущий пароль")]
        public string CurrentPassword { get; set; } = string.Empty;
    }

    private sealed class NewPasswordModel
    {
        [Required(ErrorMessage = "Введите новый пароль")]
        [MinLength(6, ErrorMessage = "Пароль должен быть не короче 6 символов")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Повторите новый пароль")]
        [Compare(nameof(NewPassword), ErrorMessage = "Пароли не совпадают")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}


